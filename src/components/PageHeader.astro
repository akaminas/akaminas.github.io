---
/**
 * The title area of a page: title, optional lede, and anything else the page
 * wants under it (a download button, a note).
 */
interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<header class="page-head container">
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>
