---
/**
 * The title area of a page: an optional eyebrow, the title over a short accent
 * rule, an optional one-line lead, and anything else the page wants under it.
 */
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}
const { title, eyebrow, lead } = Astro.props;
---

<header class="page-head">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h1>{title}</h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>
