---
/**
 * The title area of a sheet: a mono label, the title, an optional lede, and
 * anything else the page wants under it (a download button, a note).
 */
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<header class="sheet-head container">
  {eyebrow && <p class="label">{eyebrow}</p>}
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>
