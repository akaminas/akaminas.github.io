---
/**
 * Generative textures, one per discipline, drawn as inline SVG at build time.
 * Colours are Vellum tokens (var(--v-<hue>-tint), var(--v-<hue>), var(--v-<hue>-deep)),
 * so each texture recolours with the theme. Seeded, so a tile keeps its drawing.
 *
 *   voxels    isometric cube clusters with lit, shaded and dark faces (sustainability)
 *   stipple   a dot field whose density follows two peaks, with lineage curves (ecology and evolution)
 *   contours  nested bathymetric contours around two seamounts, with a line of records (marine)
 *   grid      the anatomy of a figure: claim bar, hairline grid, two series, ringed ends (tools)
 *   network   nodes joined to their nearest neighbours, one of them isolated (methods, systems)
 *
 * `grain` lays a faint film grain over the drawing (feTurbulence). Decorative unless a label is given.
 */
import { hash, mulberry32, valueNoise } from '../lib/rand';
import type { Hue, TextureKind } from '../data/domains';

interface Props {
  kind: TextureKind;
  hue: Hue;
  seed?: string | number;
  grain?: boolean;
  class?: string;
  /** Accessible description; omit for a decorative texture. */
  label?: string;
}
const { kind, hue, seed = kind, grain = false, class: className = '', label } = Astro.props;

const W = 600;
const H = 400;
const seedN = typeof seed === 'number' ? seed : hash(`${seed}|${kind}|${hue}`);
const rnd = mulberry32(seedN);
const noise = valueNoise(rnd);
const uid = `t${(seedN % 1679616).toString(36)}`;
const c = {
  tint: `var(--v-${hue}-tint)`,
  tone: `var(--v-${hue})`,
  deep: `var(--v-${hue}-deep)`,
  surface: 'var(--v-surface)',
  grid: 'var(--v-grid)',
  rule: 'var(--v-rule)',
  muted: 'var(--v-muted)',
  ink: 'var(--v-ink)',
};
const f = (n: number) => (Math.round(n * 10) / 10).toString();
const pts = (p: number[][]) => p.map(([x, y]) => `${f(x)},${f(y)}`).join(' ');
const poly = (p: number[][], style: string) => `<polygon points="${pts(p)}" style="${style}"/>`;

/** An isometric prism on cell top-vertex (x, y) from height hb to ht, half-width s. */
function prism(x: number, y: number, hb: number, ht: number, s: number): string {
  const T = [x, y - ht * s];
  const R = [x + s, y + s / 2 - ht * s];
  const B = [x, y + s - ht * s];
  const L = [x - s, y + s / 2 - ht * s];
  const Rb = [x + s, y + s / 2 - hb * s];
  const Bb = [x, y + s - hb * s];
  const Lb = [x - s, y + s / 2 - hb * s];
  const edge = `stroke:${c.surface};stroke-width:.8;stroke-linejoin:round`;
  return (
    poly([L, B, Bb, Lb], `fill:${c.tone};${edge}`) +
    poly([L, B, Bb, Lb], `fill:url(#${uid}-shl)`) +
    poly([B, R, Rb, Bb], `fill:${c.deep};${edge}`) +
    poly([B, R, Rb, Bb], `fill:url(#${uid}-shr)`) +
    poly([T, R, B, L], `fill:${c.tint};${edge}`)
  );
}

function voxels(): string {
  const u = 30;
  const N = 9;
  const ox = W / 2 + 10;
  const oy = H / 2 - (N * u) / 2 + 36;
  const cells: { i: number; j: number; h: number }[] = [];
  for (let i = 0; i < N; i++) {
    for (let j = 0; j < N; j++) {
      const cx = i - (N - 1) / 2;
      const cy = j - (N - 1) / 2;
      const d = Math.hypot(cx, cy) / ((N - 1) / 2);
      const mask = Math.max(0, 1 - d * d * 1.15);
      const n = noise(i * 0.55 + 3, j * 0.55 + 7);
      const h = Math.round((0.3 + n * 3.4) * mask);
      if (h > 0) cells.push({ i, j, h });
    }
  }
  cells.sort((a, b) => a.i + a.j - (b.i + b.j));
  let out = '';
  for (const { i, j, h } of cells) out += prism(ox + (i - j) * u, oy + ((i + j) * u) / 2, 0, h, u);
  // A few blocks drifting free, as if not yet placed.
  for (let k = 0; k < 5; k++) {
    const s = u * (0.5 + rnd() * 0.3);
    const x = 50 + rnd() * (W - 100);
    const y = 40 + rnd() * (H - 130);
    if (Math.abs(x - W / 2) < 160 && Math.abs(y - H / 2) < 120) continue;
    out += prism(x, y, 0, 1, s);
  }
  return out;
}

function stipple(): string {
  const peaks = [
    { x: 0.34, y: 0.56, s: 0.17, a: 1 },
    { x: 0.7, y: 0.4, s: 0.12, a: 0.85 },
  ];
  const dens = (x: number, y: number) =>
    peaks.reduce((acc, p) => {
      const dx = (x - p.x * W) / W;
      const dy = (y - p.y * H) / W;
      return acc + p.a * Math.exp(-(dx * dx + dy * dy) / (2 * p.s * p.s));
    }, 0);
  let out = '';
  for (let k = 0; k < 3; k++) {
    const p: number[][] = [];
    for (let x = -20; x <= W + 20; x += 24) p.push([x, H * (0.22 + 0.56 * noise(x / 140 + k * 9.3, k * 3.1 + 2))]);
    out += `<polyline points="${pts(p)}" style="fill:none;stroke:${c.tint};stroke-width:1.6;stroke-linejoin:round;opacity:.9"/>`;
  }
  let n = 0;
  for (let t = 0; t < 1500; t++) {
    const x = rnd() * W;
    const y = rnd() * H;
    const p = dens(x, y);
    if (rnd() > p * 0.95 + 0.025) continue;
    n++;
    if (n % 11 === 0) {
      out += `<circle cx="${f(x)}" cy="${f(y)}" r="${f(3.2 + p * 1.2)}" style="fill:${c.surface};stroke:${c.tone};stroke-width:1.4"/>`;
    } else {
      out += `<circle cx="${f(x)}" cy="${f(y)}" r="${f(2 + p * 1.3)}" style="fill:${p > 0.72 ? c.deep : c.tone};opacity:.92"/>`;
    }
  }
  return out;
}

function contours(): string {
  const centres = [
    { x: 0.4, y: 0.52, R: 0.44 },
    { x: 0.8, y: 0.36, R: 0.28 },
  ];
  const K = 8;
  let out = '';
  for (const cen of centres) {
    const ph = [rnd() * 6.28, rnd() * 6.28, rnd() * 6.28];
    for (let k = K; k >= 1; k--) {
      const r = cen.R * W * (k / K);
      const p: number[][] = [];
      for (let a = 0; a < 80; a++) {
        const th = (a / 80) * Math.PI * 2;
        const rr = r * (1 + 0.16 * Math.sin(3 * th + ph[0]) + 0.09 * Math.sin(5 * th + ph[1]) + 0.05 * Math.sin(8 * th + ph[2]));
        p.push([cen.x * W + rr * Math.cos(th), cen.y * H + rr * 0.78 * Math.sin(th)]);
      }
      const deepLine = k <= 2;
      const fill = k === 1 ? `${c.tint};fill-opacity:.7` : k === 2 ? `${c.tint};fill-opacity:.35` : 'none';
      const op = 0.3 + 0.65 * (1 - k / K);
      out += `<polygon points="${pts(p)}" style="fill:${fill};stroke:${deepLine ? c.deep : c.tone};stroke-width:${deepLine ? 1.4 : 1.1};stroke-opacity:${f(op)};stroke-linejoin:round"/>`;
    }
  }
  const ph = rnd() * 6.28;
  const rec: number[][] = [];
  for (let x = 36; x <= W - 36; x += 46) rec.push([x, H * 0.8 + 28 * Math.sin(x / 95 + ph)]);
  out += `<polyline points="${pts(rec)}" style="fill:none;stroke:${c.tone};stroke-width:.9;stroke-dasharray:2 5;opacity:.7"/>`;
  for (const [x, y] of rec) out += `<circle cx="${f(x)}" cy="${f(y)}" r="3.4" style="fill:${c.surface};stroke:${c.tone};stroke-width:1.3"/>`;
  return out;
}

function grid(): string {
  const L = 54;
  const R = 86;
  const T = 92;
  const B = 56;
  let out = '';
  out += `<rect x="${L}" y="30" width="236" height="9" rx="2" style="fill:${c.ink};opacity:.82"/>`;
  out += `<rect x="${L}" y="47" width="150" height="6" rx="2" style="fill:${c.muted};opacity:.55"/>`;
  out += `<rect x="${L}" y="${T - 14}" width="64" height="5" rx="2" style="fill:${c.muted};opacity:.55"/>`;
  for (let k = 0; k <= 4; k++) {
    const y = T + ((H - B - T) * k) / 4;
    out += `<line x1="${L}" x2="${W - R}" y1="${f(y)}" y2="${f(y)}" style="stroke:${c.grid};stroke-width:1"/>`;
  }
  for (let k = 0; k <= 6; k++) {
    const x = L + ((W - R - L) * k) / 6;
    out += `<line x1="${f(x)}" x2="${f(x)}" y1="${H - B}" y2="${H - B + 5}" style="stroke:${c.rule};stroke-width:1"/>`;
  }
  const ref = T + (H - B - T) * 0.42;
  out += `<line x1="${L}" x2="${W - R}" y1="${f(ref)}" y2="${f(ref)}" style="stroke:${c.rule};stroke-width:1;stroke-dasharray:1 4"/>`;
  const series = (col: string, shape: (t: number) => number, width: number) => {
    const p: number[][] = [];
    for (let k = 0; k <= 14; k++) {
      const t = k / 14;
      p.push([L + (W - R - L) * t, T + (H - B - T) * (1 - shape(t))]);
    }
    let d = `M${f(p[0][0])},${f(p[0][1])}`;
    for (let k = 1; k < p.length; k++) {
      const [x0, y0] = p[k - 1];
      const [x1, y1] = p[k];
      const cx = (x0 + x1) / 2;
      d += ` C${f(cx)},${f(y0)} ${f(cx)},${f(y1)} ${f(x1)},${f(y1)}`;
    }
    const [ex, ey] = p[p.length - 1];
    return (
      `<path d="${d}" style="fill:none;stroke:${col};stroke-width:${width};stroke-linecap:round"/>` +
      `<circle cx="${f(ex)}" cy="${f(ey)}" r="4.6" style="fill:${c.surface};stroke:${col};stroke-width:2"/>` +
      `<rect x="${f(ex + 12)}" y="${f(ey - 3.5)}" width="40" height="7" rx="2" style="fill:${c.muted};opacity:.5"/>`
    );
  };
  const n1 = rnd() * 7;
  const n2 = rnd() * 7;
  out += series(c.tone, (t) => 0.1 + 0.72 * Math.pow(t, 1.5) + 0.1 * (noise(t * 5 + n1, 1) - 0.5), 2.4);
  out += series(c.deep, (t) => 0.3 + 0.25 * t + 0.14 * (noise(t * 6 + n2, 4) - 0.5), 2);
  out += `<rect x="${L}" y="${H - 22}" width="190" height="5" rx="2" style="fill:${c.muted};opacity:.4"/>`;
  return out;
}

function network(): string {
  const nodes: number[][] = [];
  let tries = 0;
  while (nodes.length < 26 && tries++ < 4000) {
    const x = 40 + rnd() * (W - 80);
    const y = 36 + rnd() * (H - 72);
    if (nodes.every(([nx, ny]) => Math.hypot(nx - x, ny - y) > 52)) nodes.push([x, y]);
  }
  const iso = nodes.length - 1;
  const edges = new Set<string>();
  const deg: number[] = new Array(nodes.length).fill(0);
  nodes.forEach((p, i) => {
    if (i === iso) return;
    const near = nodes
      .map((q, j) => [Math.hypot(q[0] - p[0], q[1] - p[1]), j])
      .filter(([, j]) => j !== i && j !== iso)
      .sort((a, b) => a[0] - b[0])
      .slice(0, 2);
    for (const [, j] of near) {
      const key = i < j ? `${i}-${j}` : `${j}-${i}`;
      if (!edges.has(key)) {
        edges.add(key);
        deg[i]++;
        deg[j]++;
      }
    }
  });
  let out = '';
  for (const key of edges) {
    const [a, b] = key.split('-').map(Number);
    out += `<line x1="${f(nodes[a][0])}" y1="${f(nodes[a][1])}" x2="${f(nodes[b][0])}" y2="${f(nodes[b][1])}" style="stroke:${c.tone};stroke-width:1.2;opacity:.6"/>`;
  }
  const hubs = deg
    .map((d, i) => [d, i])
    .sort((a, b) => b[0] - a[0])
    .slice(0, 3)
    .map(([, i]) => i);
  nodes.forEach(([x, y], i) => {
    if (i === iso) out += `<circle cx="${f(x)}" cy="${f(y)}" r="6" style="fill:${c.surface};stroke:${c.deep};stroke-width:1.8"/>`;
    else if (hubs.includes(i)) out += `<circle cx="${f(x)}" cy="${f(y)}" r="6.5" style="fill:${c.deep}"/>`;
    else out += `<circle cx="${f(x)}" cy="${f(y)}" r="4.6" style="fill:${c.tint};stroke:${c.tone};stroke-width:1.4"/>`;
  });
  return out;
}

const defs =
  `<defs>` +
  `<linearGradient id="${uid}-shl" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".14"/></linearGradient>` +
  `<linearGradient id="${uid}-shr" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#000" stop-opacity=".05"/><stop offset="1" stop-color="#000" stop-opacity=".22"/></linearGradient>` +
  (grain
    ? `<filter id="${uid}-grain" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency=".85" numOctaves="2" seed="${seedN % 97}" stitchTiles="stitch"/><feColorMatrix values="0 0 0 0 .16 0 0 0 0 .15 0 0 0 0 .14 0 0 0 .9 0"/></filter>`
    : '') +
  `</defs>`;

const bodies: Record<TextureKind, () => string> = { voxels, stipple, contours, grid, network };
const body = bodies[kind]();
const grainRect = grain ? `<rect width="${W}" height="${H}" filter="url(#${uid}-grain)" style="opacity:.16;mix-blend-mode:multiply"/>` : '';
---

<svg
  class:list={['texture', `texture--${kind}`, className]}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={defs + body + grainRect}
/>
