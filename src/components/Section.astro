---
/**
 * A section: its name in spaced capitals over a rule, a link at the right,
 * then the content. No subtitles.
 */
interface Props {
  id: string;
  title: string;
  link?: { href: string; label: string };
  class?: string;
}
const { id, title, link, class: className = '' } = Astro.props;
const titleId = `${id}-title`;
---

<section class:list={['section', className]} id={id} aria-labelledby={titleId}>
  <div class="sec-head">
    <h2 id={titleId}>{title}</h2>
    {link && <a href={link.href}>{link.label} →</a>}
  </div>
  <slot />
</section>
