---
/**
 * A titled section: heading with a hairline under it, then content. Always the width of the column.
 */
import type { Tone } from '../data/tones';
import { toneStyle } from '../data/tones';

interface Props {
  id: string;
  title?: string;
  /** Gives the section its own pastel: the rule under the heading and anything inside that reads --tone. */
  tone?: Tone;
  class?: string;
}
const { id, title, tone, class: className = '' } = Astro.props;
const titleId = `${id}-title`;
---

<section
  class:list={['container', 'sec', { 'sec--tone': tone }, className]}
  id={id}
  aria-labelledby={title ? titleId : undefined}
  style={tone ? toneStyle(tone) : undefined}
>
  {title && <h2 id={titleId}>{title}</h2>}
  <slot />
</section>
