---
/**
 * Signature figure for the home page: a schematic phylogenetic network.
 *
 * Three layers, all drawn once at build time — this is a static SVG with no
 * client-side JavaScript and no animation:
 *
 *   1. A faint cloud of discordant histories. The species tree is resampled
 *      NREPLICATES times; each replicate jitters the divergence times and
 *      applies a few nearest-neighbour-interchange moves, so the gene trees
 *      disagree with the species tree and with each other. Tip positions are
 *      shared, so the lines cross where histories conflict — the "densitree"
 *      convention.
 *   2. The consensus species tree, drawn as a slanted cladogram over the cloud.
 *   3. Reticulation edges: dashed arrows from a donor lineage to a recipient
 *      one, the gene flow that makes this a network rather than a tree.
 *
 * The randomness is seeded, so the figure is identical on every build. It is a
 * schematic — no real data — and the caption says so. The SVG is aria-hidden;
 * the caption carries everything the figure means.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

/* ---------- geometry ---------- */
const W = 500;
const H = 414;
const X0 = 24; // root
const X1 = 452; // present (tips)
const Y0 = 16; // first tip
const DY = 36; // tip spacing
const AXIS_Y = 384;

const NREPLICATES = 70;
const TIME_SD = 0.045; // jitter on divergence times, in units of root-to-tip
const MIN_GAP = 0.035; // minimum time between a node and its parent
const P_NNI = 0.55; // chance a replicate gets at least one topology move

/* ---------- the species tree ---------- */
interface TreeNode {
  /** Divergence time, 0 at the root, 1 at the present. */
  t: number;
  label?: string;
  children: TreeNode[];
  /** Filled in by layout. */
  y?: number;
}

const leaf = (label: string): TreeNode => ({ t: 1, label, children: [] });
const clade = (t: number, children: TreeNode[]): TreeNode => ({ t, children });

const speciesTree = (): TreeNode =>
  clade(0.02, [
    clade(0.22, [
      clade(0.46, [leaf('A'), leaf('B')]),
      clade(0.38, [clade(0.62, [leaf('C'), leaf('D')]), leaf('E')]),
    ]),
    clade(0.3, [
      clade(0.55, [leaf('F'), clade(0.74, [leaf('G'), leaf('H')])]),
      clade(0.5, [leaf('I'), leaf('J')]),
    ]),
  ]);

const tips = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J'];
const tipY = new Map(tips.map((label, i) => [label, Y0 + i * DY]));

/* ---------- seeded randomness (mulberry32) ---------- */
function rng(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let x = Math.imul(a ^ (a >>> 15), 1 | a);
    x = (x + Math.imul(x ^ (x >>> 7), 61 | x)) ^ x;
    return ((x ^ (x >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(20260910);
const normal = (): number => {
  let u = 0;
  let v = 0;
  while (u === 0) u = rand();
  while (v === 0) v = rand();
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
};

/* ---------- tree operations ---------- */
const clone = (n: TreeNode): TreeNode => ({ t: n.t, label: n.label, children: n.children.map(clone) });
const isLeaf = (n: TreeNode) => n.children.length === 0;

function internals(n: TreeNode, out: TreeNode[] = []): TreeNode[] {
  if (!isLeaf(n)) {
    out.push(n);
    n.children.forEach((c) => internals(c, out));
  }
  return out;
}

/** Nearest-neighbour interchange: swap a grandchild with its uncle. */
function nni(root: TreeNode): void {
  const candidates = internals(root).filter((n) => n.children.some((c) => !isLeaf(c)));
  if (candidates.length === 0) return;
  const p = candidates[Math.floor(rand() * candidates.length)];
  const ci = !isLeaf(p.children[0]) && (isLeaf(p.children[1]) || rand() < 0.5) ? 0 : 1;
  const c = p.children[ci];
  const gi = rand() < 0.5 ? 0 : 1;
  const uncle = p.children[1 - ci];
  p.children[1 - ci] = c.children[gi];
  c.children[gi] = uncle;
}

/** Keep divergence times increasing from root to tips after jitter or a move. */
function fixTimes(n: TreeNode, floor: number): void {
  if (isLeaf(n)) {
    n.t = 1;
    return;
  }
  n.t = Math.min(Math.max(n.t, floor + MIN_GAP), 1 - MIN_GAP);
  n.children.forEach((c) => fixTimes(c, n.t));
}

/** Slanted-cladogram layout: y of an internal node is the mean of its children. */
function layout(n: TreeNode): number {
  n.y = isLeaf(n)
    ? (tipY.get(n.label as string) as number)
    : n.children.reduce((s, c) => s + layout(c), 0) / n.children.length;
  return n.y;
}

const x = (t: number) => X0 + t * (X1 - X0);
const r1 = (v: number) => Math.round(v * 10) / 10;

/** One path per tree: the root stem plus one segment per branch. */
function edges(n: TreeNode, out: string[] = []): string[] {
  for (const c of n.children) {
    out.push(`M${r1(x(n.t))} ${r1(n.y as number)}L${r1(x(c.t))} ${r1(c.y as number)}`);
    edges(c, out);
  }
  return out;
}
function path(n: TreeNode): string {
  return `M${r1(X0 - 16)} ${r1(n.y as number)}L${r1(x(n.t))} ${r1(n.y as number)}` + edges(n).join('');
}

/* ---------- the cloud ---------- */
const cloud: string[] = [];
for (let i = 0; i < NREPLICATES; i++) {
  const g = clone(speciesTree());
  if (rand() < P_NNI) {
    const moves = 1 + (rand() < 0.35 ? 1 : 0);
    for (let m = 0; m < moves; m++) nni(g);
  }
  for (const n of internals(g)) n.t += TIME_SD * normal();
  fixTimes(g, -MIN_GAP);
  layout(g);
  cloud.push(path(g));
}

/* ---------- the consensus tree ---------- */
const consensus = speciesTree();
layout(consensus);
const consensusPath = path(consensus);

/* ---------- reticulations ---------- */
/** The node whose tip set is exactly `labels`, and its parent. */
function find(labels: string[], n: TreeNode, parent: TreeNode | null = null): [TreeNode, TreeNode | null] | null {
  const want = [...labels].sort().join(',');
  const got = (m: TreeNode): string[] => (isLeaf(m) ? [m.label as string] : m.children.flatMap(got));
  if (got(n).sort().join(',') === want) return [n, parent];
  for (const c of n.children) {
    const hit = find(labels, c, n);
    if (hit) return hit;
  }
  return null;
}

/** A point a fraction `u` along the branch leading to the clade with these tips. */
function onBranch(labels: string[], u: number): [number, number] {
  const hit = find(labels, consensus);
  if (!hit) throw new Error(`no clade ${labels.join(',')}`);
  const [n, p] = hit;
  const ax = p ? x(p.t) : X0 - 16;
  const ay = p ? (p.y as number) : (n.y as number);
  return [ax + u * (x(n.t) - ax), ay + u * ((n.y as number) - ay)];
}

/** Gene flow drawn as a shallow arc, bulging away from the straight line. */
function reticulation(from: string[], fu: number, to: string[], tu: number, bow: number): string {
  const [ax, ay] = onBranch(from, fu);
  const [bx, by] = onBranch(to, tu);
  const cx = (ax + bx) / 2 + bow * (by - ay) * 0.5;
  const cy = (ay + by) / 2 - bow * (bx - ax) * 0.5;
  return `M${r1(ax)} ${r1(ay)}Q${r1(cx)} ${r1(cy)} ${r1(bx)} ${r1(by)}`;
}

const reticulations = [
  reticulation(['E'], 0.62, ['F'], 0.62, 0.45), // recent, across the two main clades
  reticulation(['C', 'D'], 0.5, ['G', 'H'], 0.55, 0.22), // older, within the network's interior
];
---

<figure class:list={['phylo', className]}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
    <defs>
      <marker id="phylo-arrow" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path class="phylo__arrowhead" d="M0 0.6 L7.5 4 L0 7.4 Z" />
      </marker>
      <marker id="phylo-tick" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path class="phylo__tick" d="M1 1.2 L6.6 4 L1 6.8" stroke-width="1.1" />
      </marker>
    </defs>

    <g class="phylo__cloud">
      {cloud.map((d) => <path d={d} />)}
    </g>

    <path class="phylo__tree" d={consensusPath} />

    <g class="phylo__retic">
      {reticulations.map((d) => <path d={d} marker-end="url(#phylo-arrow)" />)}
    </g>

    <g class="phylo__tips">
      {tips.map((label, i) => <text x={X1 + 11} y={Y0 + i * DY} dy="0.33em">{label}</text>)}
    </g>

    <g class="phylo__axis">
      <line x1={X0 - 16} y1={AXIS_Y} x2={X1} y2={AXIS_Y} marker-end="url(#phylo-tick)" />
      <text x={X0 - 16} y={AXIS_Y + 21}>past</text>
      <text x={X1} y={AXIS_Y + 21} text-anchor="end">present</text>
    </g>
  </svg>

  <figcaption class="phylo__caption">
    Schematic phylogenetic network. The dark tree is a species history; the pale lines behind it are seventy gene
    histories that disagree with it and with each other, and the dashed arrows are gene flow between
    lineages.
  </figcaption>
</figure>

<style>
  .phylo {
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  .phylo svg {
    width: 100%;
    height: auto;
  }
  .phylo__cloud path {
    fill: none;
    stroke: var(--tree-cloud);
    stroke-opacity: 0.14;
    stroke-width: 0.9;
    vector-effect: non-scaling-stroke;
  }
  .phylo__tree {
    fill: none;
    stroke: var(--tree-edge);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .phylo__retic path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-dasharray: 4 3.5;
    vector-effect: non-scaling-stroke;
  }
  /* Marker contents inherit `color` from <defs>, not from the line that
     references them, so the arrowhead and the axis tick are coloured explicitly. */
  .phylo__arrowhead {
    fill: var(--accent);
  }
  .phylo__tips text {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--muted);
  }
  .phylo__axis line {
    stroke: var(--line-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .phylo__tick {
    fill: none;
    stroke: var(--line-strong);
  }
  .phylo__axis text {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--muted);
  }
  /* The SVG scales with the column, so the labels have to grow in user units to
     stay legible once the hero stacks. */
  @media (max-width: 47.99rem) {
    .phylo__tips text {
      font-size: 17px;
    }
    .phylo__axis text {
      font-size: 15px;
    }
  }
  .phylo__caption {
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--muted);
    max-width: 52ch;
  }
</style>
