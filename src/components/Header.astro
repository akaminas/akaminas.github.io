---
/**
 * The bar at the top of every page: the mark and name, navigation in spaced
 * capitals, the colour-scheme toggle and a GitHub link. The toggle appears only
 * with JavaScript; the navigation needs none and scrolls sideways on a phone.
 */
import { nav, site } from '../data/site';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header class="site-header">
  <div class="header-in">
    <a class="brand" href="/" aria-label={`${site.name}, home`} aria-current={currentPath === '/' ? 'page' : undefined}>
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <path class="bm-edge" d="M8.5 23 L15.5 10 L22.5 23 Z" />
        <path class="bm-edge" d="M22.5 23 L27.5 12.5" />
        <circle class="bm-node" cx="8.5" cy="23" r="2.7" />
        <circle class="bm-node" cx="15.5" cy="10" r="2.7" />
        <circle class="bm-node" cx="22.5" cy="23" r="2.7" />
        <circle class="bm-iso" cx="27.5" cy="12.5" r="3.2" />
      </svg>
      <span class="brand-word">{site.name}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {nav.map((item) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <div class="header-tools">
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch to the dark theme" hidden>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
      </button>
      <a class="icon-btn" href={site.profiles.github} rel="me noopener" aria-label="GitHub profile">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" /></svg>
      </a>
    </div>
  </div>
</header>

<script>
  import { mountThemeToggle } from '../scripts/theme';
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (toggle) mountThemeToggle(toggle);
</script>
