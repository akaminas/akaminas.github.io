---
/**
 * The bar at the top of every page: name, navigation, profile links and the
 * colour-scheme toggle. The menu button and the toggle appear only with JS;
 * without it the navigation is simply visible.
 */
import { nav, site } from '../data/site';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header class="site-header">
  <div class="container container--wide site-header__inner">
    <a class="wordmark" href="/" aria-current={currentPath === '/' ? 'page' : undefined}>{site.name}</a>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <span class="menu-button__label">Menu</span>
      <span class="menu-button__icon" aria-hidden="true"><span></span><span></span></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="site-nav__profiles" aria-label="Profiles">
        <li><a href={site.profiles.github} rel="me noopener">GitHub</a></li>
        <li><a href={site.profiles.orcid} rel="me noopener">ORCID</a></li>
        <li><a href={site.profiles.scholar} rel="noopener">Scholar</a></li>
      </ul>
    </nav>

    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" hidden>
      <svg class="theme-toggle__sun" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <circle cx="9" cy="9" r="3.4" stroke="currentColor" stroke-width="1.6" />
        <path
          d="M9 1.5v2.2M9 14.3v2.2M1.5 9h2.2M14.3 9h2.2M3.7 3.7l1.55 1.55M12.75 12.75l1.55 1.55M3.7 14.3l1.55-1.55M12.75 5.25l1.55-1.55"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </svg>
      <svg class="theme-toggle__moon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M11.2 2.4a6.6 6.6 0 1 0 4.4 9.6 5.4 5.4 0 0 1-4.4-9.6Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bar);
    color: var(--bar-ink);
    font-family: var(--font-ui);
    font-weight: 600;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 3.75rem;
    flex-wrap: wrap;
  }
  .wordmark {
    color: var(--bar-ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-right: var(--space-2);
  }
  .wordmark:hover {
    color: var(--bar-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex: 1 1 auto;
    flex-wrap: wrap;
  }
  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.1rem;
    flex-wrap: wrap;
  }
  .site-nav li {
    max-width: none;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.6rem;
    text-decoration: none;
    color: var(--bar-ink);
    font-size: 1rem;
    border-radius: var(--radius-s);
  }
  .site-nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .site-nav a[aria-current='page'] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .site-nav__profiles {
    margin-left: auto !important;
  }
  .site-nav__profiles a {
    font-size: var(--step--1);
    opacity: 0.85;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: var(--radius-s);
    color: var(--bar-ink);
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: color-mix(in srgb, var(--bar-ink) 12%, transparent);
  }
  .theme-toggle__moon,
  .theme-toggle[data-state='dark'] .theme-toggle__sun {
    display: none;
  }
  .theme-toggle[data-state='dark'] .theme-toggle__moon {
    display: block;
  }

  .menu-button {
    display: none;
    align-items: center;
    gap: 0.6em;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0 0.75rem;
    background: transparent;
    border: 2px solid color-mix(in srgb, var(--bar-ink) 35%, transparent);
    border-radius: var(--radius-s);
    color: var(--bar-ink);
    cursor: pointer;
    font-size: var(--step--1);
  }
  .menu-button__icon {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    width: 18px;
  }
  .menu-button__icon span {
    display: block;
    height: 2px;
    background: currentColor;
    transition: transform var(--dur) var(--ease-out);
  }
  .menu-button[aria-expanded='true'] .menu-button__icon span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-button[aria-expanded='true'] .menu-button__icon span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (max-width: 47.99rem) {
    html.js .menu-button {
      display: inline-flex;
      margin-left: auto;
      margin-right: var(--space-1);
    }
    html.js .site-nav {
      order: 10;
      flex-basis: 100%;
    }
    html.js .site-nav[data-open='false'] {
      display: none;
    }
    html.js .site-nav {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-2) 0 var(--space-4);
      border-top: var(--rule) solid color-mix(in srgb, var(--bar-ink) 20%, transparent);
    }
    html.js .site-nav ul {
      flex-direction: column;
      gap: 0;
    }
    html.js .site-nav__profiles {
      margin-left: 0 !important;
      margin-top: var(--space-2) !important;
      border-top: var(--rule) solid color-mix(in srgb, var(--bar-ink) 20%, transparent);
      padding-top: var(--space-2);
    }
    html.js .site-nav a {
      width: 100%;
      min-height: 3rem;
      padding: 0 0.25rem;
    }
  }
  @media (max-width: 26rem) {
    .menu-button__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .menu-button {
      gap: 0;
      padding: 0 0.7rem;
    }
    .wordmark {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  import { mountThemeToggle } from '../scripts/theme';
  // Progressive enhancement: without JS the navigation is simply visible.
  document.documentElement.classList.add('js');
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (toggle) mountThemeToggle(toggle);
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const navEl = document.getElementById('site-nav');
  if (button && navEl) {
    button.hidden = false;
    const mq = window.matchMedia('(max-width: 47.99rem)');
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      navEl.dataset.open = String(open);
    };
    const sync = () => {
      if (mq.matches) setOpen(false);
      else {
        navEl.removeAttribute('data-open');
        button.setAttribute('aria-expanded', 'false');
      }
    };
    sync();
    mq.addEventListener('change', sync);
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>
