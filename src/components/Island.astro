---
/**
 * The home-page island: a static SVG model (src/components/island.svg,
 * drawn by scripts/make-island.mjs) whose parts are links. Hovering or
 * focusing a part lifts it and shows its label; there is no JavaScript.
 * A key under the figure repeats every link in plain text; it stays folded
 * away until asked for, so the page is short.
 */
import svg from './island.svg?raw';

const key = [
  { what: 'The sea and the boat', to: 'Marine systems', href: '/work/#g-marine-systems' },
  { what: 'The island and its gulls', to: 'Island ecology and evolution', href: '/work/#g-ecology-evolution' },
  { what: 'The three figures', to: 'Social and economic systems', href: '/work/#g-sustainability-social' },
  { what: 'The lighthouse at the end of the pier', to: 'Scientific tool development', href: '/work/#g-tools-visualisation' },
  { what: 'The wind turbine', to: 'Sustainability', href: '/work/sustainability-organisations-as-systems/' },
  { what: 'The windmill', to: 'Methods', href: '/methods/' },
  { what: 'The chapel', to: 'Publications', href: '/publications/' },
  { what: 'The big house', to: 'Projects', href: '/work/' },
  { what: 'The house with the awning', to: 'Teaching', href: '/teaching/' },
  { what: 'The house with the stair', to: 'About me', href: '/about/' },
  { what: 'The house by the pier', to: 'Curriculum vitae', href: '/cv/' },
];
---

<figure class="island-fig">
  <div class="island-wrap breakout" set:html={svg} />
  <figcaption class="island-key">
    <details>
      <summary>Where the parts lead</summary>
      <ul>
        {
          key.map((k) => (
            <li>
              {k.what} → <a href={k.href}>{k.to}</a>
            </li>
          ))
        }
      </ul>
    </details>
  </figcaption>
</figure>

<style>
  .island-fig {
    margin: 0;
  }
  /* .island-wrap is also .breakout (global.css): page width, centred on the column. */
  .island-wrap :global(svg) {
    width: 100%;
    height: auto;
    display: block;
    font-family: var(--font-ui);
    font-weight: 700;
  }
  .island-wrap :global(.hot) {
    cursor: pointer;
    outline: none;
  }
  .island-wrap :global(.hot__body) {
    transition: transform var(--dur) var(--ease-out), filter var(--dur) var(--ease-out);
  }
  .island-wrap :global(.hot--lift:hover .hot__body),
  .island-wrap :global(.hot--lift:focus-visible .hot__body) {
    transform: translateY(-8px);
  }
  .island-wrap :global(.hot--glow:hover .hot__body),
  .island-wrap :global(.hot--glow:focus-visible .hot__body) {
    filter: brightness(1.07);
  }
  .island-wrap :global(.hot__label) {
    display: block;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
    pointer-events: none;
  }
  .island-wrap :global(.hot:hover .hot__label),
  .island-wrap :global(.hot:focus-visible .hot__label) {
    opacity: 1;
  }
  .island-wrap :global(.hot__pill) {
    fill: var(--badge);
    stroke: var(--badge-gold);
    stroke-width: 1.5;
  }
  .island-wrap :global(.hot__text) {
    fill: var(--badge-ink);
  }
  .island-key {
    margin: var(--space-4) 0 0;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--muted);
  }
  /* Closed until chosen. The chevron is drawn, so it takes the text colour in both schemes. */
  .island-key summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    color: var(--heading);
    cursor: pointer;
    list-style: none;
  }
  .island-key summary::-webkit-details-marker {
    display: none;
  }
  .island-key summary::before {
    content: '';
    flex: none;
    width: 0.45em;
    height: 0.45em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
  }
  .island-key details[open] summary::before {
    transform: rotate(45deg);
  }
  .island-key summary:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .island-key summary:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-radius: var(--radius-s);
  }
  /* The key in flowing columns, so a long entry that wraps does not stretch the row beside it:
     two columns in the column, one on a phone. */
  .island-key ul {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    columns: 22rem 2;
    column-gap: var(--space-6);
  }
  .island-key li {
    max-width: none;
    break-inside: avoid;
    margin-bottom: var(--space-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .island-wrap :global(.hot--lift:hover .hot__body),
    .island-wrap :global(.hot--lift:focus-visible .hot__body) {
      transform: none;
      filter: brightness(1.07);
    }
  }
</style>
