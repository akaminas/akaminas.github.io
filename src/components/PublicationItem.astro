---
/**
 * One entry of a register: the [n] reference on the left (from the
 * `.register` counter), then title, authors, venue and identifiers.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  pub: CollectionEntry<'publications'>;
}
const { pub } = Astro.props;
const d = pub.data;
const statusLabel: Record<typeof d.status, string> = {
  published: 'Peer-reviewed',
  accepted: 'Accepted',
  preprint: 'Preprint',
  manuscript: 'Manuscript',
  'in-progress': 'In progress',
};
const isMe = (a: string) => /^Kaminas,\s*A\.?$/.test(a.trim());
const doiUrl = d.doi ? `https://doi.org/${d.doi}` : d.url;
const rest = [d.volume ? `${d.volume}${d.issue ? `(${d.issue})` : ''}` : undefined, d.pages].filter(Boolean).join(', ');
---

<li class="pub" id={pub.id}>
  <span class="register__ref" aria-hidden="true"></span>
  <div class="pub__body">
    <p class="pub__title">
      {doiUrl ? <a href={doiUrl} rel="noopener">{d.title}</a> : d.title}
    </p>
    <p class="pub__authors">
      {
        d.authors.map((a, i) => (
          <Fragment>
            {isMe(a) ? <strong>{a}</strong> : a}
            {i < d.authors.length - 1 ? ', ' : ''}
          </Fragment>
        ))
      }
      {d.etAl ? <span class="muted"> … et al. ({d.etAl} authors)</span> : null}
    </p>
    {
      d.venue && (
        <p class="pub__venue">
          <em>{d.venue}</em>
          {rest ? `, ${rest}` : ''}
        </p>
      )
    }
    <p class="pub__ids">
      <span>{d.year}</span>
      <span>{statusLabel[d.status]}</span>
      {d.doi && <a href={`https://doi.org/${d.doi}`} rel="noopener">doi:{d.doi}</a>}
      {d.licence && <span>{d.licence}</span>}
      {d.note && <span>{d.note}</span>}
    </p>
  </div>
</li>

<style>
  .pub__body p {
    margin: 0;
    max-width: var(--measure);
  }
  .pub__title {
    font-weight: 500;
    letter-spacing: -0.012em;
    font-size: var(--step-1);
    line-height: 1.3;
    margin-bottom: var(--space-2) !important;
    text-wrap: pretty;
  }
  .pub__title a {
    text-decoration-color: var(--line-strong);
  }
  .pub__title a:hover {
    text-decoration-color: currentColor;
  }
  .pub__authors {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .pub__authors strong {
    color: var(--ink);
    font-weight: 500;
  }
  .pub__venue {
    font-size: var(--step--1);
  }
  .pub__ids {
    margin-top: var(--space-2) !important;
    font-family: var(--font-mono);
    font-size: var(--ann);
    letter-spacing: 0.03em;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
  }
  .pub__ids > * + *::before {
    content: '·';
    margin-right: 0.6rem;
  }
  .pub__ids a {
    text-decoration-color: var(--line);
  }
</style>
