---
/**
 * One publication: title, authors, venue and identifiers.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  pub: CollectionEntry<'publications'>;
}
const { pub } = Astro.props;
const d = pub.data;
const statusLabel: Record<typeof d.status, string> = {
  published: 'Peer-reviewed',
  accepted: 'Accepted',
  preprint: 'Preprint',
  manuscript: 'Manuscript',
  'in-progress': 'In progress',
};
const isMe = (a: string) => /^Kaminas,\s*A\.?$/.test(a.trim());
const doiUrl = d.doi ? `https://doi.org/${d.doi}` : d.url;
const rest = [d.volume ? `${d.volume}${d.issue ? `(${d.issue})` : ''}` : undefined, d.pages].filter(Boolean).join(', ');
---

<li class="pub" id={pub.id}>
  <p class="pub__title">
    {doiUrl ? <a href={doiUrl} rel="noopener">{d.title}</a> : d.title}
  </p>
  <p class="pub__authors">
    {
      d.authors.map((a, i) => (
        <Fragment>
          {isMe(a) ? <strong>{a}</strong> : a}
          {i < d.authors.length - 1 ? ', ' : ''}
        </Fragment>
      ))
    }
    {d.etAl ? <span class="muted"> … et al. ({d.etAl} authors)</span> : null}
  </p>
  {
    d.venue && (
      <p class="pub__venue">
        <em>{d.venue}</em>
        {rest ? `, ${rest}` : ''}
      </p>
    )
  }
  <p class="pub__ids">
    <span>{d.year}</span>
    <span>{statusLabel[d.status]}</span>
    {d.doi && <a href={`https://doi.org/${d.doi}`} rel="noopener">doi:{d.doi}</a>}
    {d.licence && <span>{d.licence}</span>}
    {d.note && <span>{d.note}</span>}
  </p>
</li>

<style>
  .pub p {
    margin: 0;
    max-width: var(--measure);
  }
  .pub__title {
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: var(--space-1) !important;
    text-wrap: pretty;
  }
  .pub__title a {
    color: var(--heading);
  }
  .pub__title a:hover {
    color: var(--accent);
  }
  .pub__authors {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .pub__authors strong {
    color: var(--ink);
  }
  .pub__venue {
    font-size: var(--step--1);
  }
  .pub__ids {
    margin-top: var(--space-2) !important;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
  }
  .pub__ids > * + *::before {
    content: '·';
    margin-right: 0.6rem;
  }
</style>
