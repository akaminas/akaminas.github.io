---
/**
 * Decorative simulation for the home page (an adaptive landscape with populations
 * climbing it; see src/scripts/system-field.ts), presented as an annotated figure:
 * gridlines, axis labels, live readouts and the model equations. Everything
 * meaningful is in text; the canvas itself is hidden from assistive technology.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class:list={['system-field', className]}>
  <div class="system-field__frame">
    <svg class="system-field__grid" aria-hidden="true" viewBox="0 0 100 100" preserveAspectRatio="none">
      <g class="grid-minor">
        <line x1="25" y1="0" x2="25" y2="100" vector-effect="non-scaling-stroke" />
        <line x1="50" y1="0" x2="50" y2="100" vector-effect="non-scaling-stroke" />
        <line x1="75" y1="0" x2="75" y2="100" vector-effect="non-scaling-stroke" />
        <line x1="0" y1="25" x2="100" y2="25" vector-effect="non-scaling-stroke" />
        <line x1="0" y1="50" x2="100" y2="50" vector-effect="non-scaling-stroke" />
        <line x1="0" y1="75" x2="100" y2="75" vector-effect="non-scaling-stroke" />
      </g>
    </svg>
    <canvas aria-hidden="true"></canvas>
    <span class="system-field__label system-field__label--a" aria-hidden="true">adaptive landscape ln W̄</span>
    <span class="system-field__label system-field__label--y" aria-hidden="true">trait z₂</span>
    <span class="system-field__label system-field__label--x" aria-hidden="true">trait z₁</span>
  </div>

  <div class="system-field__readouts" aria-hidden="true">
    <span>populations = <b data-readout="m">30</b></span>
    <span>peaks = <b data-readout="k">3</b></span>
    <span>t = <b data-readout="t">0.0</b></span>
    <span>peak shifts = <b data-readout="shifts">0</b></span>
  </div>

  <figcaption class="system-field__caption">
    <p class="system-field__model">
      <span class="eq">d<i>z̄<sub>j</sub></i>/d<i>t</i> = <i>G<sub>j</sub></i> ∇ ln <i>W̄</i>(<i>z̄<sub>j</sub></i> − <i>δ<sub>j</sub></i>, <i>t</i>)</span>
      <span class="eq"><i>W̄</i>(<i>z̄</i>, <i>t</i>) = Σ<sub><i>k</i></sub> <i>h<sub>k</sub></i>(<i>t</i>) exp(−‖<i>z̄</i> − <i>θ<sub>k</sub></i>(<i>t</i>)‖² / 2(<i>ω<sub>k</sub></i>² + <i>P</i>))</span>
    </p>
    <p class="system-field__note">
      <span>
        Isolated populations climbing a slowly shifting adaptive landscape: each point is a population's mean
        phenotype, following the gradient of log mean fitness (Lande's equation) in its own local environment
        (offset <i>δ<sub>j</sub></i>) as the peaks drift, rise and sink. A toy model, drawn live; decorative, not a
        research result.
      </span>
      <button type="button" data-toggle aria-pressed="false" hidden>Pause simulation</button>
    </p>
  </figcaption>
</figure>

<style>
  .system-field {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .system-field__frame {
    position: relative;
    aspect-ratio: 5 / 4;
    border-left: var(--rule) solid var(--line-strong);
    border-bottom: var(--rule) solid var(--line-strong);
    overflow: hidden;
    background: var(--bg);
  }
  @media (max-width: 47.99rem) {
    .system-field__frame {
      aspect-ratio: 16 / 10;
      max-height: 16rem;
    }
  }
  .system-field canvas,
  .system-field__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .system-field__grid {
    pointer-events: none;
  }
  .system-field__grid .grid-minor line {
    stroke: var(--line);
    stroke-width: 1;
    opacity: 0.7;
  }
  .system-field__label {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    pointer-events: none;
    background: var(--bg);
    padding: 0 0.3em;
  }
  .system-field__label--a {
    left: 0.6rem;
    top: 0.5rem;
  }
  .system-field__label--y {
    left: 0.4rem;
    bottom: 0.5rem;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    padding: 0.3em 0;
  }
  .system-field__label--x {
    right: 0.6rem;
    bottom: 0.4rem;
  }
  .system-field__readouts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .system-field__readouts b {
    font-weight: 400;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .system-field__caption {
    display: grid;
    gap: var(--space-3);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .system-field__model {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--ink);
    max-width: none;
  }
  .system-field__model .eq {
    white-space: nowrap;
  }
  .system-field__model i {
    font-style: italic;
  }
  .system-field__model sub {
    font-size: 0.72em;
    line-height: 0;
  }
  .system-field__note {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    max-width: none;
  }
  .system-field__note span {
    max-width: 46ch;
  }
  .system-field__note button {
    background: transparent;
    border: var(--rule) solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink);
    min-height: 2.75rem;
    padding: 0 0.8rem;
    cursor: pointer;
    font-size: var(--step--1);
    font-weight: 500;
  }
  .system-field__note button:hover {
    border-color: var(--ink);
  }
</style>

<script>
  import { mountSystemField } from '../scripts/system-field';
  document.querySelectorAll<HTMLElement>('.system-field').forEach(mountSystemField);
</script>
