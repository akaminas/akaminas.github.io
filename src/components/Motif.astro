---
/**
 * Small original line drawings, one per project, sharing one visual grammar
 * (dots = entities, lines = interactions or trajectories, dashes = limited flow).
 * Decorative: always aria-hidden.
 */
interface Props {
  kind: 'patches' | 'bipartite' | 'fold' | 'hypervolume' | 'nested' | 'records' | 'field';
  size?: number;
  class?: string;
}
const { kind, size = 96, class: className = '' } = Astro.props;
---

<svg
  class:list={['motif', className]}
  width={size}
  height={size}
  viewBox="0 0 96 96"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {
    kind === 'patches' && (
      <g>
        <circle cx="28" cy="48" r="20" class="m-line" />
        <circle cx="70" cy="48" r="16" class="m-line" />
        <g class="m-dot">
          <circle cx="22" cy="42" r="2.4" />
          <circle cx="31" cy="52" r="2.4" />
          <circle cx="35" cy="41" r="2.4" />
          <circle cx="25" cy="56" r="2.4" />
          <circle cx="66" cy="44" r="2.4" />
          <circle cx="73" cy="53" r="2.4" />
        </g>
        <path d="M48 48 H54" class="m-dash" />
        <circle cx="76" cy="41" r="2.4" class="m-accent" />
      </g>
    )
  }
  {
    kind === 'bipartite' && (
      <g>
        <g class="m-line">
          <path d="M24 22 L72 30 M24 22 L72 50 M24 40 L72 30 M24 40 L72 68 M24 58 L72 50 M24 76 L72 68 M24 76 L72 50" />
        </g>
        <g class="m-dot">
          <circle cx="24" cy="22" r="3" />
          <circle cx="24" cy="40" r="3" />
          <circle cx="24" cy="58" r="3" />
          <circle cx="24" cy="76" r="3" />
        </g>
        <g class="m-accent">
          <circle cx="72" cy="30" r="3" />
          <circle cx="72" cy="50" r="3" />
          <circle cx="72" cy="68" r="3" />
        </g>
      </g>
    )
  }
  {
    kind === 'fold' && (
      <g>
        <path d="M12 70 C 34 70, 40 56, 44 46 C 48 36, 52 30, 84 28" class="m-line" />
        <path d="M12 74 C 40 74, 50 70, 58 62 C 64 56, 66 40, 84 32" class="m-dash" />
        <circle cx="30" cy="70" r="2.6" class="m-dot" />
        <circle cx="66" cy="31" r="2.6" class="m-accent" />
        <path d="M46 44 L46 60" class="m-accent-line" />
      </g>
    )
  }
  {
    kind === 'hypervolume' && (
      <g>
        <path d="M20 58 L34 24 L66 20 L80 44 L64 74 L30 76 Z" class="m-line" />
        <path d="M32 54 L40 36 L60 34 L68 48 L58 64 L38 66 Z" class="m-dash" />
        <g class="m-dot">
          <circle cx="42" cy="46" r="2.4" />
          <circle cx="54" cy="42" r="2.4" />
          <circle cx="50" cy="56" r="2.4" />
          <circle cx="60" cy="54" r="2.4" />
        </g>
        <circle cx="72" cy="30" r="2.4" class="m-accent" />
      </g>
    )
  }
  {
    kind === 'nested' && (
      <g>
        <circle cx="48" cy="48" r="34" class="m-line" />
        <circle cx="48" cy="48" r="21" class="m-dash" />
        <circle cx="48" cy="48" r="9" class="m-line" />
        <path d="M48 14 V27 M48 39 V48" class="m-line" />
        <circle cx="48" cy="48" r="2.6" class="m-accent" />
        <circle cx="72" cy="24" r="2.4" class="m-dot" />
        <circle cx="21" cy="66" r="2.4" class="m-dot" />
      </g>
    )
  }
  {
    kind === 'records' && (
      <g>
        <path d="M16 72 C 30 60, 34 40, 44 34 C 56 27, 64 30, 82 20" class="m-line" />
        <g class="m-dot">
          <circle cx="22" cy="66" r="2.4" />
          <circle cx="30" cy="54" r="2.4" />
          <circle cx="40" cy="38" r="2.4" />
          <circle cx="56" cy="30" r="2.4" />
        </g>
        <circle cx="70" cy="26" r="2.4" class="m-accent" />
        <circle cx="80" cy="20" r="3.8" class="m-dash" />
      </g>
    )
  }
  {
    kind === 'field' && (
      <g>
        <g class="m-dot">
          <circle cx="20" cy="26" r="2.2" />
          <circle cx="40" cy="22" r="2.2" />
          <circle cx="62" cy="28" r="2.2" />
          <circle cx="76" cy="46" r="2.2" />
          <circle cx="30" cy="52" r="2.2" />
          <circle cx="54" cy="56" r="2.2" />
          <circle cx="24" cy="74" r="2.2" />
          <circle cx="68" cy="72" r="2.2" />
        </g>
        <path d="M20 26 L40 22 L62 28 M30 52 L54 56 L68 72 M40 22 L30 52 M62 28 L76 46 L54 56" class="m-line" />
        <circle cx="46" cy="40" r="2.6" class="m-accent" />
      </g>
    )
  }
</svg>

<style>
  .motif {
    color: var(--ink);
    flex: none;
  }
  .motif .m-line {
    stroke: currentColor;
    stroke-width: 1.2;
    opacity: 0.75;
  }
  .motif .m-dash {
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-dasharray: 2.5 3;
    opacity: 0.6;
  }
  .motif .m-dot {
    fill: currentColor;
  }
  .motif .m-accent {
    fill: var(--accent);
  }
  .motif .m-accent-line {
    stroke: var(--accent);
    stroke-width: 1.4;
  }
</style>
