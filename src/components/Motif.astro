---
/**
 * Original line-and-wash drawings, one per project and one per method area,
 * so no two items share a picture. Each is a small diagram of its subject
 * (an island pair with an immigration arc, a fold curve, a phylogeny, a phase
 * portrait ...) in one drawing grammar: ink outlines, one pastel tone for
 * fills, a deeper mix of that tone for the thing being followed, dashes for
 * what is not actually present (flows, unstable states, hulls).
 *
 * The tone is read from --tone (set by the section, card or panel around the
 * drawing; see src/data/tones.ts). Decorative: always aria-hidden.
 */
export type MotifKind =
  // projects
  | 'isolation'
  | 'bipartite'
  | 'fold'
  | 'hypervolume'
  | 'loop'
  | 'records'
  | 'swatches'
  // method areas
  | 'compartments'
  | 'walks'
  | 'phase'
  | 'graph'
  | 'tree'
  | 'scatter'
  | 'survey'
  | 'contours'
  // the 404 page
  | 'lost';

interface Props {
  kind: MotifKind;
  size?: number;
  class?: string;
}
const { kind, size = 96, class: className = '' } = Astro.props;

/** An open arrowhead whose tip is at (x, y) and which points along `deg` (0 = right, 90 = down). */
const h = (x: number, y: number, deg: number, s = 3.6) => ({
  d: `M${-s} ${-s * 0.75} L0 0 L${-s} ${s * 0.75}`,
  transform: `translate(${x} ${y}) rotate(${deg})`,
});

// Likert-style bars for the survey drawing: five segment widths per row, 62 wide in all.
const bars = [
  [8, 14, 10, 18, 12],
  [12, 10, 14, 16, 10],
  [6, 12, 16, 14, 14],
  [14, 18, 8, 12, 10],
].map((row, i) => {
  let x = 22;
  return row.map((w, k) => {
    const seg = { x, w, k, y: 20 + i * 16 };
    x += w;
    return seg;
  });
});
---

<svg
  class:list={['motif', className]}
  width={size}
  height={size}
  viewBox="0 0 96 96"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {
    kind === 'isolation' && (
      <g>
        <path class="hair" d="M10 80 q5 -3 10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0" />
