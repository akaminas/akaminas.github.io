---
/**
 * The foot of every page: name and affiliation, the profiles, and the
 * copyright line, which links to the privacy and content notes.
 */
import { nav, site } from '../data/site';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-in">
    <div>
      <p class="footer-brand">
        <span class="serif">{site.name}</span> · {site.position}, <abbr title={site.affiliation.unit}>TRÊS</abbr>, {site.affiliation.name}
      </p>
      <p>
        <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.profiles.orcid} rel="me noopener">ORCID {site.orcidId}</a>
      </p>
    </div>
    <ul class="footer-nav" aria-label="Site and profiles">
      {nav.map((item) => <li><a href={item.href} aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
      <li><a href={site.profiles.github} rel="me noopener">GitHub</a></li>
      <li><a href={site.profiles.scholar} rel="noopener">Scholar</a></li>
      <li><a href={site.profiles.rug} rel="noopener">RUG</a></li>
      <li><a href={site.profiles.researchgate} rel="noopener">ResearchGate</a></li>
      <li><a href="/privacy/">Privacy</a></li>
    </ul>
    <p class="footer-stamp">
      © {year} {site.name}. Text and original graphics are mine; <a href="/privacy/#content">publications and fonts carry their own licences</a>. Set in Vellum.
    </p>
  </div>
</footer>
