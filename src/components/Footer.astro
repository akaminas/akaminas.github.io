---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__id">
      <span class="serif">{site.name}</span>
      <span class="muted"> · {site.affiliation.name}</span>
    </p>
    <ul class="site-footer__links" aria-label="Contact and profiles">
      <li><a href={`mailto:${site.email}`}>Email</a></li>
      <li><a href={site.profiles.github} rel="me noopener">GitHub</a></li>
      <li><a href={site.profiles.orcid} rel="me noopener">ORCID</a></li>
      <li><a href={site.profiles.scholar} rel="noopener">Google Scholar</a></li>
      <li><a href="/privacy/">Privacy</a></li>
      <li><a href={site.repo} rel="noopener">Source</a></li>
    </ul>
    <p class="site-footer__note muted small">
      © {year} {site.name}. Text and original graphics on this site are mine; publications and fonts carry their own
      licences (see the <a href="/privacy/#content">privacy and content notes</a>). No cookies, no analytics.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--rule) solid var(--line);
    padding-block: var(--space-6) var(--space-7);
    margin-top: var(--space-8);
  }
  .site-footer__inner {
    display: grid;
    gap: var(--space-4);
  }
  .site-footer__id {
    margin: 0;
    font-size: var(--step-0);
  }
  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--space-4);
  }
  .site-footer__links li {
    max-width: none;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
    color: var(--muted);
    font-weight: 500;
  }
  .site-footer__links a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .site-footer__note {
    margin: 0;
    max-width: 60ch;
  }
</style>
