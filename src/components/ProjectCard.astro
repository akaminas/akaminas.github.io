---
/**
 * A project as a card: its drawing, domain, title and question, and a line
 * with status, period and the first methods.
 */
import type { CollectionEntry } from 'astro:content';
import Motif from './Motif.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}
const { project, headingLevel = 'h3' } = Astro.props;
const { data } = project;
const Heading = headingLevel;
const domainLabel: Record<typeof data.domain, string> = {
  'ecology-evolution': 'Ecology & evolution',
  'sustainability-social': 'Sustainability & social systems',
  'marine-systems': 'Marine systems & monitoring',
};
const statusLabel: Record<typeof data.status, string> = {
  ongoing: 'Ongoing',
  completed: 'Completed',
  published: 'Published',
};
---

<article class="card project-card">
  <div class="project-card__top">
    <Motif kind={data.motif} size={56} />
    <span class="project-card__domain">{domainLabel[data.domain]}</span>
  </div>
  <a class="project-card__link" href={`/work/${project.id}/`}>
    <Heading class="project-card__title">{data.title}</Heading>
    <p class="project-card__question">{data.question}</p>
  </a>
  <p class="project-card__meta">
    <span class:list={['status', `status--${data.status}`]}>{statusLabel[data.status]}</span>
    <span class="mono">{data.period}</span>
    {data.methods.length > 0 && <span class="muted">{data.methods.slice(0, 3).join(' · ')}</span>}
  </p>
</article>

<style>
  .project-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .project-card__domain {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--muted);
    text-align: right;
  }
  .project-card__link {
    text-decoration: none;
    color: inherit;
    display: grid;
    gap: var(--space-2);
    flex: 1 0 auto;
  }
  .project-card__link:hover {
    color: inherit;
  }
  .project-card__title {
    margin: 0;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .project-card__link:hover .project-card__title,
  .project-card__link:focus-visible .project-card__title {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .project-card__question {
    margin: 0;
    color: var(--muted);
    font-size: var(--step--1);
    text-wrap: pretty;
  }
  .project-card__meta {
    margin: 0;
    padding-top: var(--space-3);
    border-top: var(--rule) solid var(--line);
    font-size: var(--step--1);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    max-width: none;
  }
</style>
