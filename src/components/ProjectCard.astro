---
/**
 * A project as a row: its line diagram on a tinted panel in the lead column, the
 * text beside it (Work page). The title link covers the whole item.
 */
import type { CollectionEntry } from 'astro:content';
import Motif from './Motif.astro';
import { domainTone, toneStyle } from '../data/tones';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}
const { project, headingLevel = 'h3' } = Astro.props;
const { data } = project;
const Heading = headingLevel;
const statusLabel: Record<typeof data.status, string> = {
  ongoing: 'Ongoing',
  completed: 'Completed',
  published: 'Published',
};
---

<article class="pcard pcard--row" style={toneStyle(domainTone[data.domain])}>
  <div class="thumb pcard__fig" aria-hidden="true">
    <Motif kind={data.motif} size={96} />
  </div>
  <div class="pcard__body">
    <Heading class="pcard__title">
      <a href={`/work/${project.id}/`}>{data.title}</a>
    </Heading>
    <p class="pcard__question">{data.question}</p>
    <p class="pcard__meta">
      <span class:list={['status', `status--${data.status}`]}>{statusLabel[data.status]}</span>
      <span class="mono">{data.period}</span>
      {data.methods.length > 0 && <span class="muted">{data.methods.slice(0, 3).join(' · ')}</span>}
    </p>
  </div>
</article>

<style>
  .pcard {
    position: relative;
  }
  .pcard__body {
    min-width: 0;
  }
  .pcard__title {
    margin: 0 0 var(--space-2);
  }
  .pcard__title a {
    color: var(--heading);
    text-decoration: none;
  }
  /* The link covers the whole item. */
  .pcard__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .pcard__title a:hover,
  .pcard__title a:focus-visible {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .pcard__question {
    margin: 0 0 var(--space-3);
    color: var(--muted);
    font-size: var(--step--1);
    text-wrap: pretty;
  }
  .pcard__meta {
    margin: 0;
    font-size: var(--step--1);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    max-width: none;
  }
</style>
