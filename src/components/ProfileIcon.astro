---
/**
 * Small line glyphs for the profile links in the header. They are original,
 * generic drawings (angle brackets, an identity card, a mortarboard), not the
 * services' own logos, in the same stroke as the theme toggle. Decorative: the
 * link carries the name.
 */
interface Props {
  name: 'github' | 'orcid' | 'scholar';
}
const { name } = Astro.props;
---

<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {
    name === 'github' && (
      <>
        <path d="M5.8 5 1.8 9l4 4M12.2 5l4 4-4 4" />
        <path d="M10.4 3.4 7.6 14.6" />
      </>
    )
  }
  {
    name === 'orcid' && (
      <>
        <rect x="2" y="3.5" width="14" height="11" rx="2" />
        <circle cx="6.5" cy="8" r="1.6" />
        <path d="M4 12.2c.5-1.2 1.4-1.8 2.5-1.8s2 .6 2.5 1.8M10.6 7.4h3M10.6 10.4h3" />
      </>
    )
  }
  {
    name === 'scholar' && (
      <>
        <path d="M9 3 16.5 7 9 11 1.5 7Z" />
        <path d="M4.6 8.8v3.4c0 1 1.9 2.3 4.4 2.3s4.4-1.3 4.4-2.3V8.8" />
        <path d="M16.5 7v4" />
      </>
    )
  }
</svg>
