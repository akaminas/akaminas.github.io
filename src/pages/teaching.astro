---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';

const entries = (await getCollection('teaching')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(entries.map(async (e) => ({ e, Content: (await render(e)).Content })));
const courses = rendered.filter(({ e }) => e.data.code);
const rest = rendered.filter(({ e }) => !e.data.code);

const groups = [
  { kind: 'supervision', title: 'Supervision' },
  { kind: 'teaching', title: 'Earlier teaching' },
  { kind: 'service', title: 'Academic service' },
  { kind: 'outreach', title: 'Outreach' },
] as const;
---

<Base
  title="Teaching and supervision"
  description="Teaching by Alexandros Kaminas: teaching assistant for the MSc courses Mathematical models for Biology, Programming C++ for Biologists and Modelling Complex Biological Systems at the University of Groningen; MSc research project supervision at TRÊS; peer review and academic service."
>
  <PageHeader title="Teaching and supervision" lead="Passing the modelling toolkit on: framing a question so a model can answer it, choosing a structure the data can support, and reading the results critically." />

  <Section id="courses" title="Courses">
    <ul class="courses">
      {
        courses.map(({ e, Content }) => (
          <li>
            <article class="course">
              <span class="eyebrow">
                {e.data.code} · {e.data.credits} ECTS · {e.data.level} · {e.data.block}
              </span>
              <h3>
                {e.data.url ? (
                  <a href={e.data.url} rel="noopener">
                    {e.data.title}
                  </a>
                ) : (
                  e.data.title
                )}
              </h3>
              <p class="course-role">
                {e.data.role} · {e.data.institution}, {e.data.period}
              </p>
              <div class="course-text">
                <Content />
              </div>
              {e.data.url && (
                <a class="more" href={e.data.url} rel="noopener">
                  Course catalogue →
                </a>
              )}
            </article>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    groups.map((g) => {
      const items = rest.filter(({ e }) => e.data.kind === g.kind);
      if (items.length === 0) return null;
      return (
        <Section id={`t-${g.kind}`} title={g.title}>
          <ol class="ledger entries">
            {items.map(({ e, Content }) => (
              <li>
                <span class="ledger__when">{e.data.period}</span>
                <div>
                  <p class="ledger__title">{e.data.project ? <a href={`/work/${e.data.project}/`}>{e.data.title}</a> : e.data.title}</p>
                  <p class="ledger__where">
                    {e.data.role} · {e.data.institution}
                  </p>
                  <div class="ledger__note entry-text">
                    <Content />
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </Section>
      );
    })
  }
</Base>

<style>
  .entries {
    --ledger-col: 8rem;
  }
  .entry-text :global(p) {
    margin: 4px 0 0;
    max-width: var(--measure);
  }
</style>
