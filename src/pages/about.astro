---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { site } from '../data/site';

const experience = [
  {
    period: 'Oct 2025 – present',
    title: 'PhD researcher',
    where: 'University of Groningen — TRÊS (Etienne and Van Doorn groups)',
    note: 'The evolutionary consequences of isolation. EVOLVE fellow (EU MSCA COFUND).',
  },
  {
    period: '2026 – 2027',
    title: 'Teaching assistant',
    where: 'University of Groningen — MSc Biology',
    note: 'Mathematical models for Biology; Programming C++ for Biologists; Modelling Complex Biological Systems.',
  },
  {
    period: 'Jan 2025 – present',
    title: 'Research associate',
    where: 'Political Economy of Sustainable Development Lab, University of Athens',
    note: 'Climate-change reporting, data visualisation and scientific storytelling.',
  },
  {
    period: 'Nov 2023 – present',
    title: 'Network coordinator (since May 2025); sustainability research fellow (2023–2025)',
    where: 'SDSN Youth Greece',
    note: 'Collaborations and projects on the Sustainable Development Goals.',
  },
  {
    period: 'Oct 2024 – Sep 2025',
    title: 'Meteorology and oceanography officer; administration officer',
    where: 'Hydrographic Service, Hellenic Navy',
    note: 'Oceanographic models and forecasts; acoustic data for submarine surveys; administrative systems in Python.',
  },
  {
    period: 'Jan – Jun 2024',
    title: 'Research intern (MSc research)',
    where: 'UMR MARBEC, Montpellier',
    note: 'Regime shifts and community reorganisation under climate change and fishing.',
  },
  {
    period: 'Jan – Jun 2023',
    title: 'Research intern',
    where: 'UMR MARBEC, Sète',
    note: 'Functional diversity of fish communities: hypervolumes, phylogenetic inference, trait imputation.',
  },
  {
    period: 'Sep – Dec 2021',
    title: 'Erasmus research intern',
    where: 'UMR MARBEC, Sète',
    note: 'Functional diversity under global change.',
  },
  {
    period: '2021 – present',
    title: 'Working group member',
    where: 'WGCOMEDA',
    note: 'Comparative analysis of Mediterranean and Atlantic ecosystems.',
  },
  {
    period: 'Jun – Sep 2020',
    title: 'Research intern',
    where: 'Hellenic Centre for Marine Research',
    note: 'Taxonomy, stomach-content analysis and diet indices of commercial fish.',
  },
  {
    period: '2018 – 2023',
    title: 'Volunteer research fellow',
    where: 'iSea Environmental Organisation',
    note: 'Monitoring invasive species and elasmobranchs; citizen-science programmes.',
  },
];

const education = [
  { period: '2025 – present', degree: 'PhD, The evolutionary consequences of isolation', where: 'University of Groningen' },
  {
    period: '2022 – 2024',
    degree: 'MSc, Applied Ecological and Evolutionary Sciences',
    where: 'University of Montpellier',
    note: 'Second in class. IDIL international student scholarship.',
  },
  { period: '2017 – 2021', degree: 'BSc, Marine Science', where: 'University of the Aegean', note: 'First in class; valedictorian.' },
];

const awards = [
  { year: 2025, what: 'EVOLVE fellowship', by: 'EU EVOLVE MSCA COFUND' },
  { year: 2022, what: 'IDIL international student scholarship', by: 'University of Montpellier' },
  { year: 2022, what: 'Academic excellence award', by: 'Greek State Scholarships Foundation (IKY)' },
  { year: 2021, what: 'Valedictorian', by: 'University of the Aegean' },
  { year: 2017, what: 'National excellence mention', by: 'Secondary education, Greece' },
];
---

<Base
  title="About"
  description="About Alexandros Kaminas: PhD researcher in theoretical and evolutionary ecology at the University of Groningen (TRÊS), trained in marine science (Aegean) and ecological and evolutionary sciences (Montpellier); teaching assistant for MSc modelling courses; sustainability research in Greece."
  ogType="profile"
>
  <PageHeader title="About" lead="I model living systems: communities that assemble, populations that evolve, and the organisations that depend on them." />

  <section class="about" aria-label="Profile">
    <figure class="portrait">
      <picture>
        <source type="image/avif" srcset="/images/portrait-480.avif 480w, /images/portrait-960.avif 960w" sizes="(min-width: 60rem) 18rem, 60vw" />
        <source type="image/webp" srcset="/images/portrait-480.webp 480w, /images/portrait-960.webp 960w" sizes="(min-width: 60rem) 18rem, 60vw" />
        <img
          src="/images/portrait-640.jpg"
          width="640"
          height="800"
          alt="Alexandros Kaminas, portrait in a dark suit against a white background."
          loading="eager"
          decoding="async"
        />
      </picture>
      <figcaption>{site.name}, {site.location}.</figcaption>
    </figure>
    <div class="prose">
      <p>
        I am a PhD researcher at the University of Groningen, in the Theoretical Research in Evolutionary Life Sciences cluster (TRÊS), with
        Rampal Etienne and Sander van Doorn. My project, <em>The evolutionary consequences of isolation</em>, asks how limited immigration
        shapes what emerges, persists and goes extinct in a community. It is funded by an EVOLVE fellowship (EU MSCA COFUND).
      </p>
      <p>
        I trained in marine science at the University of the Aegean and in ecological and evolutionary sciences at the University of
        Montpellier, with research at UMR MARBEC on regime shifts and functional diversity, after years of marine monitoring through citizen
        science with iSea.
      </p>
      <p>
        Alongside the PhD I assist in three MSc modelling courses at Groningen, coordinate SDSN Youth Greece, and work with the Political
        Economy of Sustainable Development Lab at the University of Athens on climate-change reporting.
      </p>
      <p>Greek, English and French. Based in Groningen.</p>
      <div class="cta-row">
        <a class="btn-solid" href="/cv/">Curriculum vitae</a>
        <a class="btn-outline" href={`mailto:${site.email}`}>Email</a>
      </div>
    </div>
  </section>

  <Section id="experience" title="Positions">
    <ol class="ledger timeline">
      {
        experience.map((e) => (
          <li>
            <span class="ledger__when">{e.period}</span>
            <div>
              <p class="ledger__title">{e.title}</p>
              <p class="ledger__where">{e.where}</p>
              <p class="ledger__note">{e.note}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="education" title="Degrees">
    <ol class="ledger timeline">
      {
        education.map((e) => (
          <li>
            <span class="ledger__when">{e.period}</span>
            <div>
              <p class="ledger__title">{e.degree}</p>
              <p class="ledger__where">{e.where}</p>
              {e.note && <p class="ledger__note">{e.note}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="awards" title="Fellowships and awards">
    <ol class="ledger timeline">
      {
        awards.map((a) => (
          <li>
            <span class="ledger__when">{a.year}</span>
            <div>
              <p class="ledger__title">{a.what}</p>
              <p class="ledger__where">{a.by}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="profiles" title="Profiles">
    <ul class="profiles">
      <li><a href={site.profiles.orcid} rel="me noopener">ORCID {site.orcidId}</a></li>
      <li><a href={site.profiles.scholar} rel="noopener">Google Scholar</a></li>
      <li><a href={site.profiles.github} rel="me noopener">GitHub</a></li>
      <li><a href={site.profiles.rug} rel="noopener">University of Groningen</a></li>
      <li><a href={site.profiles.researchgate} rel="noopener">ResearchGate</a></li>
    </ul>
  </Section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 48px;
    align-items: start;
    margin: 0 0 112px;
  }
  .about .portrait {
    max-width: 18rem;
  }
  .about .cta-row {
    margin-top: 24px;
  }
  .timeline {
    --ledger-col: 11rem;
  }
  @media (max-width: 760px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      margin-bottom: 80px;
    }
    .about .portrait {
      max-width: 14rem;
    }
  }
</style>
