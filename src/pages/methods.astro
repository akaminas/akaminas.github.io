---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Texture from '../components/Texture.astro';
import type { Hue, TextureKind } from '../data/domains';

/**
 * Only methods with documented use in a project, thesis or publication are listed.
 * Each entry names where the method was used so the claim can be checked.
 */
interface Area {
  id: string;
  texture: TextureKind;
  hue: Hue;
  title: string;
  text: string;
  used: { label: string; href: string }[];
}
const areas: Area[] = [
  {
    id: 'mechanistic',
    texture: 'stipple',
    hue: 'teal',
    title: 'Mechanistic and eco-evolutionary modelling',
    text: 'Models built from explicit processes: immigration, interaction, diversification and extinction as rates; traits under selection; populations whose dynamics feed back on evolution.',
    used: [
      { label: 'The evolutionary consequences of isolation', href: '/work/evolutionary-consequences-of-isolation/' },
      { label: 'Trait evolution in mutualistic networks', href: '/work/trait-evolution-in-mutualistic-networks/' },
    ],
  },
  {
    id: 'stochastic',
    texture: 'voxels',
    hue: 'moss',
    title: 'Stochastic simulation and numerical experiments',
    text: 'Individual- and population-level stochastic models studied by simulation when analysis runs out. Engines in C++; experiments designed, run and read from R.',
    used: [
      { label: 'The evolutionary consequences of isolation', href: '/work/evolutionary-consequences-of-isolation/' },
      { label: 'Regime shifts in Mediterranean communities', href: '/work/regime-shifts-mediterranean-communities/' },
    ],
  },
  {
    id: 'dynamical',
    texture: 'contours',
    hue: 'terracotta',
    title: 'Dynamical systems, transitions and resilience',
    text: 'Equilibria, stability and abrupt transitions: catastrophe theory for discontinuous community dynamics, regime-shift analysis of time series under several pressures.',
    used: [{ label: 'Regime shifts in Mediterranean communities', href: '/work/regime-shifts-mediterranean-communities/' }],
  },
  {
    id: 'networks',
    texture: 'network',
    hue: 'indigo',
    title: 'Interaction networks and systems frameworks',
    text: 'Interactions as networks whose structure depends on traits and feeds back on dynamics; the same systems view applied to organisations and institutions.',
    used: [
      { label: 'Trait evolution in mutualistic networks', href: '/work/trait-evolution-in-mutualistic-networks/' },
      { label: 'Organisations, institutions and sustainability', href: '/work/sustainability-organisations-as-systems/' },
    ],
  },
  {
    id: 'trait-space',
    texture: 'stipple',
    hue: 'mauve',
    title: 'Trait space, functional diversity and phylogenetics',
    text: 'n-dimensional hypervolumes for occupied trait space; phylogenetic inference and phylogeny-informed imputation for incomplete trait data.',
    used: [{ label: 'Functional diversity of Mediterranean fish communities', href: '/work/functional-diversity-mediterranean-fish/' }],
  },
  {
    id: 'statistics',
    texture: 'grid',
    hue: 'ochre',
    title: 'Statistics and model-to-data comparison',
    text: 'Effects of pressures estimated from observational data; model expectations set against community records; survey and monitoring data analysed quantitatively.',
    used: [
      { label: 'Regime shifts in Mediterranean communities', href: '/work/regime-shifts-mediterranean-communities/' },
      { label: 'Tracking marine invasions with citizen science', href: '/work/citizen-science-marine-invasions/' },
      { label: 'Organisations, institutions and sustainability', href: '/work/sustainability-organisations-as-systems/' },
    ],
  },
  {
    id: 'spatial',
    texture: 'contours',
    hue: 'indigo',
    title: 'Spatial analysis, oceanographic models and visualisation',
    text: 'GIS, satellite imagery and a year of operational oceanographic forecasting; data visualisation and scientific storytelling for climate reporting; the Vellum figure system.',
    used: [
      { label: 'Hydrographic Service, Hellenic Navy', href: '/about/#experience' },
      { label: 'Vellum', href: '/work/vellum/' },
    ],
  },
];

const tools = [
  { name: 'C++', note: 'simulation engines' },
  { name: 'R', note: 'analysis, statistics, visualisation' },
  { name: 'Python', note: 'analysis, data pipelines, tooling' },
  { name: 'MATLAB', note: 'basic' },
  { name: 'QGIS / ArcGIS', note: 'spatial analysis' },
  { name: 'LaTeX', note: 'papers, posters, figure styles' },
  { name: 'Git', note: 'version control' },
];
---

<Base
  title="Methods"
  description="Modelling methods used by Alexandros Kaminas: mechanistic eco-evolutionary models, stochastic simulation, dynamical systems and catastrophe theory, interaction networks, trait-space hypervolumes, statistics and spatial methods. C++, R and Python."
>
  <PageHeader title="Methods" lead="Every method here is tied to a project where it was used." />

  <Section id="areas" title="Method areas">
    <ol class="methods">
      {
        areas.map((a) => (
          <li>
            <article class="method" id={a.id}>
              <span class="method-disc" aria-hidden="true">
                <Texture kind={a.texture} hue={a.hue} seed={`method-${a.id}`} />
              </span>
              <div>
                <h3>{a.title}</h3>
                <p>{a.text}</p>
                <p class="used">
                  Used in{' '}
                  {a.used.map((u, i) => (
                    <Fragment>
                      {i > 0 ? ' · ' : ''}
                      <a href={u.href}>{u.label}</a>
                    </Fragment>
                  ))}
                </p>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="tools" title="Languages and software">
    <dl class="tools">
      {
        tools.map((t) => (
          <div>
            <dt>{t.name}</dt>
            <dd>{t.note}</dd>
          </div>
        ))
      }
    </dl>
  </Section>
</Base>
