---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const talks = (await getCollection('talks')).sort((a, b) => b.data.date.localeCompare(a.data.date));

const groups = [
  {
    key: 'ecology-evolution',
    title: 'Ecology and evolution',
    intro:
      'The primary domain. Eco-evolutionary models of community assembly, trait evolution and regime shifts, from doctoral research to MSc work.',
  },
  {
    key: 'sustainability-social',
    title: 'Sustainability and social systems',
    intro: 'Systems reasoning applied to organisations, institutions and policy.',
  },
  {
    key: 'marine-systems',
    title: 'Marine systems and monitoring',
    intro: 'Earlier empirical work: species monitoring and citizen science in the eastern Mediterranean.',
  },
] as const;

const typeLabel = { oral: 'Oral', poster: 'Poster', invited: 'Invited', seminar: 'Seminar' } as const;
const fmtDate = (iso: string) => {
  const [y, m] = iso.split('-');
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  return m ? `${months[Number(m) - 1]} ${y}` : y;
};
---

<Base
  title="Work"
  description="Research projects by Alexandros Kaminas presented as modelling case studies: eco-evolutionary dynamics of isolation, trait evolution in mutualistic networks, regime shifts, functional diversity, sustainability systems and citizen science. Plus conference talks."
>
  <PageHeader
    eyebrow="Work"
    title="Projects as modelling problems"
    lede="Each project is described by its question, the system, the model structure and what came out of it. The subject changes; the modelling language persists."
  />

  {
    groups.map((g) => {
      const items = projects.filter((p) => p.data.domain === g.key);
      if (items.length === 0) return null;
      return (
        <section class="section container" aria-labelledby={`g-${g.key}`}>
          <div class="grid-label">
            <div class="grid-label__aside">
              <h2 id={`g-${g.key}`} class="group-title">
                {g.title}
              </h2>
              <p class="muted small">{g.intro}</p>
            </div>
            <div class="cards">
              {items.map((p) => (
                <ProjectCard project={p} />
              ))}
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="section section--rule container" aria-labelledby="talks-title" id="talks">
    <div class="grid-label">
      <div class="grid-label__aside">
        <h2 id="talks-title" class="group-title">Talks and posters</h2>
        <p class="muted small">Conference presentations, most recent first.</p>
      </div>
      <ol class="ruled talks">
        {
          talks.map((t) => (
            <li>
              <div class="talk__meta">
                <span class="talk__date">{fmtDate(t.data.date)}</span>
                <span class="status">{typeLabel[t.data.type]}</span>
              </div>
              <div class="talk__body">
                <p class="talk__title">
                  {t.data.project ? <a href={`/work/${t.data.project}/`}>{t.data.title}</a> : t.data.title}
                </p>
                <p class="talk__event">
                  {t.data.event} · {t.data.location}
                </p>
                {t.data.authors.length > 1 && <p class="talk__authors muted small">{t.data.authors.join(', ')}</p>}
                {t.data.abstract && <p class="small">{t.data.abstract}</p>}
                {t.data.note && <p class="muted small">{t.data.note}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .group-title {
    font-size: var(--step-2);
    margin-bottom: var(--space-2);
  }
  .cards {
    display: grid;
    gap: 0 var(--space-7);
  }
  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .talks li {
    display: grid;
    gap: var(--space-2) var(--space-6);
  }
  @media (min-width: 42rem) {
    .talks li {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
  }
  .talk__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .talk__date {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .talk__body p {
    margin: 0 0 var(--space-1);
  }
  .talk__title {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.3;
    text-wrap: pretty;
  }
  .talk__event {
    font-size: var(--step--1);
  }
</style>
