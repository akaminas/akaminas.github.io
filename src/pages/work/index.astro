---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { domainTone } from '../../data/tones';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const talks = (await getCollection('talks')).sort((a, b) => b.data.date.localeCompare(a.data.date));

const groups = [
  {
    key: 'ecology-evolution',
    title: 'Ecology and evolution',
  },
  {
    key: 'sustainability-social',
    title: 'Sustainability and social systems',
  },
  {
    key: 'marine-systems',
    title: 'Marine systems and monitoring',
  },
  {
    key: 'tools-visualisation',
    title: 'Tools and visualisation',
  },
] as const;

const typeLabel = { oral: 'Oral', poster: 'Poster', invited: 'Invited', seminar: 'Seminar' } as const;
---

<Base
  title="Work"
  lead="14rem"
  description="Projects and talks by Alexandros Kaminas: eco-evolutionary dynamics of isolation, trait evolution in mutualistic networks, regime shifts, functional diversity, organisations and sustainability, citizen-science monitoring, and conference talks."
>
  <PageHeader title="Work" />

  {
    groups.map((g) => {
      const items = projects.filter((p) => p.data.domain === g.key);
      if (items.length === 0) return null;
      return (
        <Section id={`g-${g.key}`} title={g.title} tone={domainTone[g.key]}>
          <div class="rows">
            {items.map((p) => (
              <ProjectCard project={p} />
            ))}
          </div>
        </Section>
      );
    })
  }

  <Section id="talks" title="Talks and posters">
    <ol class="ledger talks">
      {
        talks.map((t) => (
          <li>
            <span class="ledger__when">
              {t.data.date}
              <span class="ledger__tag">{typeLabel[t.data.type]}</span>
            </span>
            <div class="talk__body">
              <p class="talk__title">
                {t.data.project ? <a href={`/work/${t.data.project}/`}>{t.data.title}</a> : t.data.title}
              </p>
              <p class="talk__event">
                {t.data.event} · {t.data.location}
              </p>
              {t.data.authors.length > 1 && <p class="muted small">{t.data.authors.join(', ')}</p>}
              {t.data.abstract && <p class="small talk__abstract">{t.data.abstract}</p>}
              {t.data.note && <p class="muted small">{t.data.note}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </Section>
</Base>

<style>
  .talk__body p {
    margin: 0 0 var(--space-1);
  }
  .talk__title {
    font-weight: 700;
    text-wrap: pretty;
  }
  .talk__event {
    font-size: var(--step--1);
  }
  .talk__abstract {
    margin-top: var(--space-2) !important;
  }
</style>
