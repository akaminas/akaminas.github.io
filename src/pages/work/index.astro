---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import { domains, domainOrder } from '../../data/domains';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const talks = (await getCollection('talks')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const groups = domainOrder.map((key) => ({ key, ...domains[key], items: projects.filter((p) => p.data.domain === key) })).filter((g) => g.items.length > 0);
const typeLabel = { oral: 'Oral', poster: 'Poster', invited: 'Invited', seminar: 'Seminar' } as const;
---

<Base
  title="Work"
  description="Research projects by Alexandros Kaminas as modelling case studies: eco-evolutionary dynamics of isolation, trait evolution in mutualistic networks, regime shifts, functional diversity, sustainability systems, citizen science and the Vellum figure system. Plus conference talks."
>
  <PageHeader title="Work">
    <ul class="toc">
      {groups.map((g) => <li><a href={`#g-${g.key}`}>{g.label}</a></li>)}
      <li><a href="#talks">Talks and posters</a></li>
    </ul>
  </PageHeader>

  {
    groups.map((g) => (
      <Section id={`g-${g.key}`} title={g.label}>
        <div class="tiles">
          {g.items.map((p) => (
            <ProjectTile project={p} />
          ))}
        </div>
      </Section>
    ))
  }

  <Section id="talks" title="Talks and posters">
    <ol class="ledger talks">
      {
        talks.map((t) => (
          <li>
            <span class="ledger__when">
              {t.data.date}
              <span class="ledger__tag">{typeLabel[t.data.type]}</span>
            </span>
            <div>
              <p class="ledger__title">{t.data.project ? <a href={`/work/${t.data.project}/`}>{t.data.title}</a> : t.data.title}</p>
              <p class="ledger__where">
                {t.data.event} · {t.data.location}
              </p>
              {t.data.authors.length > 1 && <p class="ledger__note">{t.data.authors.join(', ')}</p>}
              {t.data.note && <p class="ledger__note">{t.data.note}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </Section>
</Base>

<style>
  .talks {
    --ledger-col: 8rem;
  }
  .talks .ledger__title a {
    color: inherit;
    text-decoration: none;
  }
  .talks .ledger__title a:hover {
    color: var(--accent);
  }
</style>
