---
import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Texture from '../../components/Texture.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import { site } from '../../data/site';
import { domains, statusLabel } from '../../data/domains';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { data } = project;
const { Content } = await render(project);
const dom = domains[data.domain];

const pubs = (await Promise.all(data.publications.map((id) => getEntry('publications', id)))).filter(
  (p): p is CollectionEntry<'publications'> => Boolean(p),
);
const talks = (await Promise.all(data.talks.map((id) => getEntry('talks', id)))).filter(
  (t): t is CollectionEntry<'talks'> => Boolean(t),
);
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((p) => p.id === project.id);
const next = all[(idx + 1) % all.length];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  url: new URL(Astro.url.pathname, Astro.site).href,
  author: { '@id': `${site.url}/#person` },
  about: data.methods,
  ...(data.funding ? { funder: { '@type': 'Organization', name: data.funding } } : {}),
};
---

<Base title={data.title} description={data.summary} schema={[schema]} ogType="article">
  <article>
    <header class="project-hero bleed">
      {
        data.image ? (
          <>
            <img class="twin-light" src={data.image.light} alt="" width="720" height="476" loading="eager" decoding="async" />
            <img class="twin-dark" src={data.image.dark} alt="" width="720" height="476" loading="eager" decoding="async" />
          </>
        ) : (
          <Texture kind={data.texture ?? dom.texture} hue={dom.hue} seed={project.id} grain />
        )
      }
      <div class="title-card">
        <span class="mono-label">
          <a href="/work/">Work</a> · {dom.label}
        </span>
        <h1>{data.title}</h1>
      </div>
    </header>

    <div class="project-body">
      <aside class="project-aside" aria-label="Project facts">
        <dl class="spec spec--stacked">
          <dt>Status</dt>
          <dd><span class:list={['status', `status--${data.status}`]}>{statusLabel[data.status]}</span></dd>
          <dt>Period</dt>
          <dd>{data.period}</dd>
          <dt>Role</dt>
          <dd>{data.role}</dd>
          {
            data.institutions.length > 0 && (
              <>
                <dt>Where</dt>
                <dd>
                  {data.institutions.map((i) => (
                    <div>{i}</div>
                  ))}
                </dd>
              </>
            )
          }
          {
            data.collaborators.length > 0 && (
              <>
                <dt>With</dt>
                <dd>{data.collaborators.join(', ')}</dd>
              </>
            )
          }
          {
            data.funding && (
              <>
                <dt>Funding</dt>
                <dd>{data.funding}</dd>
              </>
            )
          }
          {
            data.methods.length > 0 && (
              <>
                <dt>Methods</dt>
                <dd>
                  <ul class="chips">
                    {data.methods.map((m) => (
                      <li>{m}</li>
                    ))}
                  </ul>
                </dd>
              </>
            )
          }
          {
            data.tools.length > 0 && (
              <>
                <dt>Tools</dt>
                <dd>
                  <ul class="chips">
                    {data.tools.map((m) => (
                      <li>{m}</li>
                    ))}
                  </ul>
                </dd>
              </>
            )
          }
          {
            data.links.length > 0 && (
              <>
                <dt>Links</dt>
                <dd>
                  {data.links.map((l) => (
                    <div>
                      <a href={l.url} rel="noopener">
                        {l.label}
                      </a>
                    </div>
                  ))}
                </dd>
              </>
            )
          }
        </dl>
      </aside>

      <div>
        <p class="lead">{data.question}</p>
        <div class="prose">
          <Content />

          {
            talks.length > 0 && (
              <section aria-labelledby="proj-talks">
                <h2 id="proj-talks">Presentations</h2>
                <ul class="ledger project-talks">
                  {talks.map((t) => (
                    <li>
                      <span class="ledger__when">{t.data.date}</span>
                      <div>
                        <p class="ledger__title">{t.data.title}</p>
                        <p class="ledger__where">
                          {t.data.event}, {t.data.location} · {t.data.type === 'oral' ? 'Oral presentation' : 'Poster'}
                        </p>
                        {t.data.authors.length > 1 && <p class="ledger__note">{t.data.authors.join(', ')}</p>}
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            pubs.length > 0 && (
              <section aria-labelledby="proj-pubs">
                <h2 id="proj-pubs">Publications</h2>
                <ol class="register">
                  {pubs.map((p) => (
                    <PublicationItem pub={p} />
                  ))}
                </ol>
              </section>
            )
          }
        </div>
      </div>
    </div>

    <nav class="project-next" aria-label="Next project">
      <span class="eyebrow">Next project</span>
      <a href={`/work/${next.id}/`}>{next.data.title} →</a>
    </nav>
  </article>
</Base>

<style>
  .project-hero :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  .mono-label a {
    color: inherit;
    text-decoration: none;
  }
  .mono-label a:hover {
    color: var(--accent);
  }
  .project-talks {
    --ledger-col: 6rem;
    margin-top: 8px;
    padding-left: 0;
  }
  @media (max-width: 620px) {
    .project-hero :global(img) {
      position: static;
      height: 200px;
    }
  }
</style>
