---
import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Motif from '../../components/Motif.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import { site } from '../../data/site';
import { domainTone, toneStyle } from '../../data/tones';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { data } = project;
const { Content } = await render(project);

const pubs = (await Promise.all(data.publications.map((id) => getEntry('publications', id)))).filter(
  (p): p is CollectionEntry<'publications'> => Boolean(p),
);
const talks = (await Promise.all(data.talks.map((id) => getEntry('talks', id)))).filter(
  (t): t is CollectionEntry<'talks'> => Boolean(t),
);
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((p) => p.id === project.id);
const next = all[(idx + 1) % all.length];

const statusLabel = { ongoing: 'Ongoing', completed: 'Completed', published: 'Published' } as const;
const domainLabel = {
  'ecology-evolution': 'Ecology & evolution',
  'sustainability-social': 'Sustainability & social systems',
  'marine-systems': 'Marine systems & monitoring',
  'tools-visualisation': 'Tools & visualisation',
} as const;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  url: new URL(Astro.url.pathname, Astro.site).href,
  author: { '@id': `${site.url}/#person` },
  about: data.methods,
  ...(data.funding ? { funder: { '@type': 'Organization', name: data.funding } } : {}),
};
---

<Base title={data.title} description={data.summary} schema={[schema]} ogType="article">
  <article style={toneStyle(domainTone[data.domain])}>
    <header class="page-head container project-head">
      <div class="project-head__fig tint" aria-hidden="true">
        <Motif kind={data.motif} size={80} />
      </div>
      <div class="project-head__text">
        <p class="label">
          <a href="/work/">Work</a> · {domainLabel[data.domain]}
        </p>
        <h1>{data.title}</h1>
        <p class="lede">{data.question}</p>
      </div>
    </header>

    <div class="container project-body">
      <aside class="project-body__aside">
        <dl class="spec">
          <dt>Status</dt>
          <dd><span class:list={['status', `status--${data.status}`]}>{statusLabel[data.status]}</span></dd>
          <dt>Period</dt>
          <dd class="mono">{data.period}</dd>
          <dt>Role</dt>
          <dd>{data.role}</dd>
          {
            data.institutions.length > 0 && (
              <>
                <dt>Where</dt>
                <dd>
                  {data.institutions.map((i) => (
                    <div>{i}</div>
                  ))}
                </dd>
              </>
            )
          }
          {
            data.collaborators.length > 0 && (
              <>
                <dt>With</dt>
                <dd>{data.collaborators.join(', ')}</dd>
              </>
            )
          }
          {
            data.funding && (
              <>
                <dt>Funding</dt>
                <dd>{data.funding}</dd>
              </>
            )
          }
          {
            data.methods.length > 0 && (
              <>
                <dt>Methods</dt>
                <dd>
                  <ul class="chips">
                    {data.methods.map((m) => (
                      <li>{m}</li>
                    ))}
                  </ul>
                </dd>
              </>
            )
          }
          {
            data.tools.length > 0 && (
              <>
                <dt>Tools</dt>
                <dd>
                  <ul class="chips">
                    {data.tools.map((m) => (
                      <li>{m}</li>
                    ))}
                  </ul>
                </dd>
              </>
            )
          }
          {
            data.links.length > 0 && (
              <>
                <dt>Links</dt>
                <dd>
                  {data.links.map((l) => (
                    <div>
                      <a href={l.url} rel="noopener">
                        {l.label}
                      </a>
                    </div>
                  ))}
                </dd>
              </>
            )
          }
        </dl>
      </aside>

      <div class="prose">
        <Content />

        {
          talks.length > 0 && (
            <section aria-labelledby="proj-talks">
              <h2 id="proj-talks">Presentations</h2>
              <ul class="ledger project-talks">
                {talks.map((t) => (
                  <li>
                    <span class="ledger__when">{t.data.date}</span>
                    <div>
                      <p class="ledger__title">{t.data.title}</p>
                      <p class="ledger__where">
                        {t.data.event}, {t.data.location} ·{' '}
                        {t.data.type === 'oral' ? 'Oral presentation' : 'Poster'}
                      </p>
                      {t.data.authors.length > 1 && <p class="ledger__note">{t.data.authors.join(', ')}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          pubs.length > 0 && (
            <section aria-labelledby="proj-pubs">
              <h2 id="proj-pubs">Publications</h2>
              <ol class="register">
                {pubs.map((p) => (
                  <PublicationItem pub={p} />
                ))}
              </ol>
            </section>
          )
        }
      </div>
    </div>

    <nav class="container project-next" aria-label="Next project">
      <p class="label">Next project</p>
      <a class="arrow-link project-next__link" href={`/work/${next.id}/`}>{next.data.title}</a>
    </nav>
  </article>
</Base>

<style>
  .project-head {
    display: grid;
    gap: var(--space-4) var(--lead-gap);
    align-items: start;
  }
  @media (min-width: 42rem) {
    .project-head {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }
  }
  .project-head__fig {
    border-radius: 8px;
    width: 5.5rem;
    height: 5.5rem;
    display: grid;
    place-items: center;
  }
  .project-head .lede {
    margin: 0;
  }
  /* One column: the facts as a panel, then the text. */
  .project-body {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
  .project-body__aside {
    background: var(--surface);
    border: var(--rule) solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-5);
  }
  .project-body__aside .spec {
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-3) var(--lead-gap);
  }
  .project-talks {
    margin-top: var(--space-4);
  }
  .project-next {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: var(--rule) solid var(--line);
  }
  .project-next__link {
    font-size: var(--step-1);
  }
</style>
