---
import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Motif from '../../components/Motif.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { data } = project;
const { Content } = await render(project);

const pubs = (await Promise.all(data.publications.map((id) => getEntry('publications', id)))).filter(
  (p): p is CollectionEntry<'publications'> => Boolean(p),
);
const talks = (await Promise.all(data.talks.map((id) => getEntry('talks', id)))).filter(
  (t): t is CollectionEntry<'talks'> => Boolean(t),
);
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((p) => p.id === project.id);
const next = all[(idx + 1) % all.length];
const plateNo = String(idx + 1).padStart(2, '0');

const statusLabel = { ongoing: 'Ongoing', completed: 'Completed', published: 'Published' } as const;
const domainLabel = {
  'ecology-evolution': 'Ecology & evolution',
  'sustainability-social': 'Sustainability & social systems',
  'marine-systems': 'Marine systems & monitoring',
} as const;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  url: new URL(Astro.url.pathname, Astro.site).href,
  author: { '@id': `${site.url}/#person` },
  about: data.methods,
  ...(data.funding ? { funder: { '@type': 'Organization', name: data.funding } } : {}),
};
---

<Base title={data.title} description={data.summary} schema={[schema]} ogType="article">
  <article>
    <header class="sheet-head container project-head">
      <div class="project-head__text">
        <p class="label">
          <a href="/work/">Work</a> · {domainLabel[data.domain]} · <span class="num">Pl. {plateNo}</span>
        </p>
        <h1>{data.title}</h1>
        <p class="lede">{data.question}</p>
      </div>
      <figure class="plate project-head__plate">
        <div class="plate__head">
          <span class="num">Pl. {plateNo}</span>
          <span>{data.motif}</span>
        </div>
        <div class="project-head__fig">
          <Motif kind={data.motif} size={120} />
        </div>
      </figure>
    </header>

    <div class="container project-body dim">
      <aside class="project-body__aside">
        <dl class="spec spec--stacked">
          <dt>Status</dt>
          <dd><span class:list={['status', `status--${data.status}`]}>{statusLabel[data.status]}</span></dd>
          <dt>Period</dt>
          <dd class="mono">{data.period}</dd>
          <dt>Role</dt>
          <dd>{data.role}</dd>
          {
            data.institutions.length > 0 && (
              <>
                <dt>Where</dt>
                <dd>
                  {data.institutions.map((i) => (
                    <div>{i}</div>
                  ))}
                </dd>
              </>
            )
          }
          {
            data.collaborators.length > 0 && (
              <>
                <dt>With</dt>
                <dd>{data.collaborators.join(', ')}</dd>
              </>
            )
          }
          {
            data.funding && (
              <>
                <dt>Funding</dt>
                <dd>{data.funding}</dd>
              </>
            )
          }
          {
            data.methods.length > 0 && (
              <>
                <dt>Methods</dt>
                <dd>
                  <ul class="chips">
                    {data.methods.map((m) => (
                      <li>{m}</li>
                    ))}
                  </ul>
                </dd>
              </>
            )
          }
          {
            data.tools.length > 0 && (
              <>
                <dt>Tools</dt>
                <dd>
                  <ul class="chips">
                    {data.tools.map((m) => (
                      <li>{m}</li>
                    ))}
                  </ul>
                </dd>
              </>
            )
          }
          {
            data.links.length > 0 && (
              <>
                <dt>Links</dt>
                <dd>
                  {data.links.map((l) => (
                    <div>
                      <a href={l.url} rel="noopener">
                        {l.label}
                      </a>
                    </div>
                  ))}
                </dd>
              </>
            )
          }
        </dl>
      </aside>

      <div class="prose">
        <Content />

        {
          talks.length > 0 && (
            <section aria-labelledby="proj-talks">
              <h2 id="proj-talks">Presentations</h2>
              <ul class="ledger project-talks">
                {talks.map((t) => (
                  <li>
                    <span class="ledger__when">{t.data.date}</span>
                    <div>
                      <p class="ledger__title">{t.data.title}</p>
                      <p class="ledger__where">
                        {t.data.event}, {t.data.location} ·{' '}
                        {t.data.type === 'oral' ? 'Oral presentation' : 'Poster'}
                      </p>
                      {t.data.authors.length > 1 && <p class="ledger__note">{t.data.authors.join(', ')}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          pubs.length > 0 && (
            <section aria-labelledby="proj-pubs" class="register-group">
              <h2 id="proj-pubs">Publications</h2>
              <ol class="register">
                {pubs.map((p) => (
                  <PublicationItem pub={p} />
                ))}
              </ol>
            </section>
          )
        }
      </div>
    </div>

    <nav class="container project-next dim" aria-label="Next project">
      <p class="label">Next · Pl. {String(((idx + 1) % all.length) + 1).padStart(2, '0')}</p>
      <a class="arrow-link project-next__link" href={`/work/${next.id}/`}>{next.data.title}</a>
    </nav>
  </article>
</Base>

<style>
  .project-head {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 52rem) {
    .project-head {
      grid-template-columns: minmax(0, 1fr) 14rem;
      gap: var(--space-8);
    }
  }
  .project-head h1 {
    max-width: 16em;
  }
  .project-head .lede {
    margin: 0;
  }
  .project-head__plate {
    display: none;
  }
  @media (min-width: 52rem) {
    .project-head__plate {
      display: flex;
      margin-top: var(--space-2);
    }
  }
  .project-head__fig {
    display: grid;
    place-items: center;
    padding: var(--space-5);
    background-image:
      linear-gradient(var(--grid) var(--rule), transparent var(--rule)),
      linear-gradient(90deg, var(--grid) var(--rule), transparent var(--rule));
    background-size: 1rem 1rem;
    background-position: center;
  }
  .project-body {
    display: grid;
    gap: var(--space-6) var(--space-7);
    padding-block: var(--space-6) var(--space-8);
  }
  @media (min-width: 52rem) {
    .project-body {
      grid-template-columns: 15rem minmax(0, 1fr);
      padding-block: var(--space-7) var(--space-9);
    }
    .project-body__aside {
      position: sticky;
      top: 5.25rem;
    }
  }
  .project-talks {
    --ledger-col: 6rem;
    margin-top: var(--space-4);
  }
  .project-next {
    padding-block: var(--space-6) var(--space-7);
  }
  .project-next__link {
    letter-spacing: -0.018em;
    font-size: var(--step-2);
  }
</style>
