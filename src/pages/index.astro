---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import ProjectTile from '../components/ProjectTile.astro';
import Texture from '../components/Texture.astro';
import { site } from '../data/site';
import { domains } from '../data/domains';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const vellum = projects.find((p) => p.id === 'vellum');
const pubs = await getCollection('publications');
const talks = await getCollection('talks');
const courses = (await getCollection('teaching'))
  .filter((t) => t.data.kind === 'teaching' && t.data.code)
  .sort((a, b) => a.data.order - b.data.order);

const facts = [
  [pubs.filter((p) => p.data.status === 'published').length, 'peer-reviewed papers'],
  [talks.length, 'talks and posters'],
  [courses.length, 'MSc courses assisted'],
  [3, 'working languages'],
] as const;

const pillars = (['ecology-evolution', 'sustainability-social', 'marine-systems'] as const).map((key) => ({ key, ...domains[key] }));

const recent = [
  { when: '2026-10', what: 'Teaching assistant for three MSc courses in mathematical modelling and C++ at Groningen.', href: '/teaching/', label: 'Teaching' },
  { when: '2026-06', what: 'Talk at the NVTB Annual Schoorl Meeting: isolation as a dynamic driver of eco-evolutionary change.', href: '/work/evolutionary-consequences-of-isolation/', label: 'The project' },
  { when: '2026-04', what: 'Paper in Circular Economy and Sustainability on organisational commitment to sustainability among Greek NGOs.', href: '/publications/#alevizos-2026-ngo-sustainability', label: 'The paper' },
  { when: '2025-10', what: 'Started the PhD at the University of Groningen as an EVOLVE fellow (EU MSCA COFUND).', href: '/about/', label: 'About' },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: site.position,
  description: site.description,
  image: `${site.url}/images/portrait-640.jpg`,
  affiliation: {
    '@type': 'Organization',
    name: site.affiliation.name,
    url: 'https://www.rug.nl/',
    department: { '@type': 'Organization', name: site.affiliation.unit, url: site.affiliation.url },
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Montpellier' },
    { '@type': 'CollegeOrUniversity', name: 'University of the Aegean' },
  ],
  knowsAbout: [
    'Mathematical modelling',
    'Computational modelling',
    'Eco-evolutionary dynamics',
    'Theoretical ecology',
    'Evolutionary biology',
    'Stochastic simulation',
    'Complex systems',
    'Sustainability science',
    'Scientific visualisation',
  ],
  identifier: { '@type': 'PropertyValue', propertyID: 'ORCID', value: site.orcidId },
  sameAs: [site.profiles.orcid, site.profiles.github, site.profiles.scholar, site.profiles.rug, site.profiles.researchgate],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  author: { '@id': `${site.url}/#person` },
};
---

<Base title="Home" description={site.description} home schema={[personSchema, websiteSchema]} ogType="profile">
  <section class="intro" aria-label="Introduction">
    <div>
      <span class="eyebrow">PhD researcher · University of Groningen · TRÊS</span>
      <h1>{site.name}</h1>
      <p class="lead">Mathematical and computational models of ecological, evolutionary and sustainability systems.</p>
      <div class="cta-row">
        <a class="btn-solid" href="/work/">View the work</a>
        <a class="btn-outline" href="/cv/">Curriculum vitae</a>
      </div>
    </div>
    <Hero />
  </section>

  <ul class="facts" aria-label="In numbers">
    {
      facts.map(([n, label]) => (
        <li>
          <b>{n}</b>
          <span>{label}</span>
        </li>
      ))
    }
  </ul>

  <Section id="research" title="Research" link={{ href: '/work/', label: 'All projects' }}>
    <div class="pillars">
      {
        pillars.map((p) => (
          <a class="pillar" href={`/work/#g-${p.key}`}>
            <span class="pillar-art" aria-hidden="true">
              <Texture kind={p.texture} hue={p.hue} seed={`pillar-${p.key}`} />
            </span>
            <h3>{p.label}</h3>
            <p>{p.line}</p>
            <span class="more">Projects →</span>
          </a>
        ))
      }
    </div>
  </Section>

  <Section id="work" title="Selected work" link={{ href: '/work/', label: 'All projects and talks' }}>
    <div class="tiles">
      {featured.map((p) => <ProjectTile project={p} />)}
    </div>
  </Section>

  {
    vellum && vellum.data.image && (
      <Section id="tools" title="Tools" link={{ href: site.profiles.vellum, label: 'Vellum' }}>
        <div class="feature">
          <div class="feature-art">
            <img class="twin-light" src={vellum.data.image.light} alt={vellum.data.image.alt} width="720" height="476" loading="lazy" decoding="async" />
            <img class="twin-dark" src={vellum.data.image.dark} alt="" width="720" height="476" loading="lazy" decoding="async" />
          </div>
          <div>
            <h3>Vellum, a visual language for scientific figures</h3>
            <p>{vellum.data.summary}</p>
            <div class="cta-row">
              <a class="btn-outline" href="/work/vellum/">The project</a>
              <a class="btn-outline" href={site.profiles.vellum} rel="noopener">The site</a>
            </div>
          </div>
        </div>
      </Section>
    )
  }

  <Section id="methods" title="Methods" link={{ href: '/methods/', label: 'In detail' }}>
    <p class="lead">
      Mechanistic models, studied by stochastic simulation and dynamical-systems analysis, and confronted with data. Engines in C++; analysis in R and Python.
    </p>
    <ul class="chips" aria-label="Method areas">
      <li>Eco-evolutionary models</li>
      <li>Stochastic simulation</li>
      <li>Dynamical systems and transitions</li>
      <li>Interaction networks</li>
      <li>Trait space and functional diversity</li>
      <li>Statistical modelling</li>
      <li>Spatial analysis</li>
      <li>Data visualisation</li>
    </ul>
  </Section>

  <Section id="teaching" title="Teaching" link={{ href: '/teaching/', label: 'Teaching and supervision' }}>
    <ul class="courses">
      {
        courses.map((c) => (
          <li>
            <article class="course">
              <span class="eyebrow">
                {c.data.code} · {c.data.credits} ECTS · {c.data.level}
              </span>
              <h3>
                <a href={c.data.url} rel="noopener">
                  {c.data.title}
                </a>
              </h3>
              <p class="course-role">
                {c.data.role} · {c.data.institution}, {c.data.period}
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="recent" title="Recent">
    <ol class="ledger recent">
      {
        recent.map((r) => (
          <li>
            <span class="ledger__when">{r.when}</span>
            <div>
              <p class="ledger__title">{r.what}</p>
              <p class="ledger__where">
                <a href={r.href}>{r.label} →</a>
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="contact" title="Contact">
    <p class="lead">Open to collaboration on eco-evolutionary dynamics, complex systems and quantitative sustainability, and to student modelling projects.</p>
    <div class="cta-row">
      <a class="btn-solid" href={`mailto:${site.email}`}>Email</a>
      <a class="btn-outline" href={site.profiles.orcid} rel="me noopener">ORCID</a>
      <a class="btn-outline" href={site.profiles.scholar} rel="noopener">Google Scholar</a>
    </div>
  </Section>
</Base>

<style>
  .recent {
    --ledger-col: 6rem;
  }
  .recent a {
    text-decoration: none;
  }
</style>
