---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Island from '../components/Island.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const projects = all.filter((p) => p.data.featured);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: site.position,
  description: site.description,
  image: `${site.url}/images/portrait-640.jpg`,
  affiliation: {
    '@type': 'Organization',
    name: site.affiliation.name,
    url: 'https://www.rug.nl/',
    department: { '@type': 'Organization', name: site.affiliation.unit, url: site.affiliation.url },
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Montpellier' },
    { '@type': 'CollegeOrUniversity', name: 'University of the Aegean' },
  ],
  knowsAbout: [
    'Complex systems',
    'Mathematical modelling',
    'Computational modelling',
    'Eco-evolutionary dynamics',
    'Theoretical ecology',
    'Evolutionary biology',
    'Stochastic simulation',
    'Sustainability science',
  ],
  identifier: { '@type': 'PropertyValue', propertyID: 'ORCID', value: site.orcidId },
  sameAs: [site.profiles.orcid, site.profiles.github, site.profiles.scholar, site.profiles.rug, site.profiles.researchgate],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  author: { '@id': `${site.url}/#person` },
};
---

<Base title="Home" description={site.description} home schema={[personSchema, websiteSchema]} ogType="profile">
  <section class="container intro" aria-label="Introduction">
    <h1>{site.name}</h1>
    <p class="intro__role">
      {site.position}, <abbr title={site.affiliation.unit}>TRÊS</abbr>, {site.affiliation.name}
    </p>
    <div class="intro__grid">
      <picture class="intro__portrait">
        <source
          type="image/avif"
          srcset="/images/portrait-480.avif 480w, /images/portrait-960.avif 960w"
          sizes="(min-width: 42rem) 16rem, 60vw"
        />
        <source
          type="image/webp"
          srcset="/images/portrait-480.webp 480w, /images/portrait-960.webp 960w"
          sizes="(min-width: 42rem) 16rem, 60vw"
        />
        <img
          src="/images/portrait-640.jpg"
          width="640"
          height="800"
          alt="Alexandros Kaminas, portrait in a dark suit against a white background."
          loading="eager"
          decoding="async"
        />
      </picture>
      <div class="intro__text">
        <p class="intro__tagline">Modelling complex systems.</p>
        <p>
          I build mathematical and computational models of systems whose behaviour emerges from interaction, feedback
          and chance: communities of species, evolving populations, and the organisations and economies that depend on
          them.
        </p>
        <p>
          <strong>Explore the island below</strong> to find my projects, methods, publications and teaching: the sea
          leads to marine work, the island to ecology and evolution, the three figures to social and economic systems,
          and each house to a page.
        </p>
        <p class="intro__ids">
          <a href={site.profiles.orcid} rel="me noopener">ORCID {site.orcidId}</a>
          <a href={site.profiles.github} rel="me noopener">github.com/akaminas</a>
          <a href={site.profiles.rug} rel="noopener">research.rug.nl</a>
        </p>
      </div>
    </div>
  </section>

  <Section id="island" title="Explore the island" wide>
    <Island />
  </Section>

  <Section id="scope" title="One modelling language, several systems">
    <ol class="chain" aria-label="From core expertise to applications">
      <li><span>Complex systems</span></li>
      <li><span>Mathematical &amp; computational modelling</span></li>
      <li><span>Ecology &amp; evolution</span></li>
      <li><span>Sustainability</span></li>
      <li><span>Social &amp; economic systems</span></li>
    </ol>
    <div class="scope">
      <div class="scope__col">
        <h3>Core expertise</h3>
        <p>
          Mechanistic models of interacting components: dynamical systems, stochastic simulation, population and
          trait-based models, and networks of interactions. The question is always how structure and randomness at
          one level produce behaviour at another.
        </p>
      </div>
      <div class="scope__col">
        <h3>Primary domain</h3>
        <p>
          Ecology and evolution. My doctoral research at the University of Groningen models how isolation and limited
          immigration reshape community assembly, diversification and extinction, with ecological and evolutionary
          change coupled.
        </p>
      </div>
      <div class="scope__col">
        <h3>Interdisciplinary applications</h3>
        <p>
          Sustainability and socioeconomic systems, where I apply the same systems reasoning to organisations and
          institutions: a 2026 paper on organisational commitment to sustainability, and policy and reporting work
          with SDSN Youth Greece and the University of Athens.
        </p>
      </div>
    </div>
  </Section>

  <Section id="work" wide>
    <div class="sec__head">
      <h2 id="work-title">Case studies</h2>
      <a class="arrow-link" href="/work/">All projects and talks</a>
    </div>
    <div class="cards">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </Section>

  <Section id="methods" title="How the models are built">
    <div class="stack">
      <p>
        The subject changes from project to project; the toolkit does not. Models are formulated mechanistically,
        studied by stochastic simulation and dynamical-systems analysis, and confronted with data using statistical
        methods. Simulation engines in C++, analysis and visualisation in R and Python.
      </p>
      <ul class="chips" aria-label="Method areas">
        <li>Eco-evolutionary models</li>
        <li>Stochastic simulation</li>
        <li>Dynamical systems &amp; transitions</li>
        <li>Interaction networks</li>
        <li>Trait-space &amp; functional diversity</li>
        <li>Statistical modelling</li>
        <li>Spatial analysis</li>
        <li>Data visualisation</li>
      </ul>
      <a class="arrow-link" href="/methods/">Methods in detail</a>
    </div>
  </Section>

  <Section id="recent" title="Recent, 2025 – 2026">
    <ol class="ledger recent">
      <li>
        <span class="ledger__when">2026-06</span>
        <span class="recent__what">
          Talk at the NVTB Annual Schoorl Meeting:{' '}
          <a href="/work/evolutionary-consequences-of-isolation/"><em>Isolation as a dynamic driver of eco-evolutionary change</em></a>.
        </span>
      </li>
      <li>
        <span class="ledger__when">2026-04</span>
        <span class="recent__what">
          Paper published in <em>Circular Economy and Sustainability</em> on{' '}
          <a href="/publications/#alevizos-2026-ngo-sustainability">organisational commitment to sustainability among Greek NGOs</a>.
        </span>
      </li>
      <li>
        <span class="ledger__when">2026</span>
        <span class="recent__what">
          Supervised an MSc research project on{' '}
          <a href="/work/trait-evolution-in-mutualistic-networks/">trait evolution in mutualistic networks</a> at TRÊS.
        </span>
      </li>
      <li>
        <span class="ledger__when">2025-10</span>
        <span class="recent__what">
          Started the PhD <em>The evolutionary consequences of isolation</em> at the University of Groningen as an
          EVOLVE fellow (EU MSCA COFUND).
        </span>
      </li>
    </ol>
  </Section>

  <Section id="contact" title="Collaboration and supervision">
    <div class="stack">
      <p>
        I am glad to hear from researchers working on eco-evolutionary dynamics, complex systems and quantitative
        sustainability, and from students interested in modelling projects.
      </p>
      <p>
        <a class="button button--primary" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </Section>
</Base>

<style>
  .intro {
    padding-block: var(--space-7) var(--space-4);
  }
  .intro h1 {
    margin-bottom: var(--space-1);
  }
  .intro__role {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: var(--space-6);
  }
  .intro__role abbr {
    text-decoration: none;
  }
  .intro__grid {
    display: grid;
    gap: var(--space-5) var(--space-7);
    align-items: start;
  }
  @media (min-width: 42rem) {
    .intro__grid {
      grid-template-columns: 16rem minmax(0, 1fr);
    }
  }
  .intro__portrait {
    width: min(100%, 16rem);
  }
  .intro__portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .intro__tagline {
    font-family: var(--font-display);
    font-size: var(--disp-2);
    color: var(--heading);
    margin-bottom: var(--space-3);
    line-height: 1.3;
  }
  .intro__text p {
    text-align: left;
  }
  .intro__ids {
    margin: var(--space-5) 0 0;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--step--1);
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    max-width: none;
  }
  .intro__ids a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
  }

  /* Chain: the scope as a row of mono labels with arrows between them. */
  .chain {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) 0;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--step--1);
  }
  .chain li {
    display: flex;
    align-items: center;
    max-width: none;
  }
  .chain li span {
    padding: 0.25em 0.8em;
    border: 2px solid var(--line-strong);
    border-radius: 999px;
    text-wrap: balance;
  }
  .chain li:first-child span {
    background: var(--accent);
    color: var(--on-accent);
    border-color: var(--accent);
  }
  .chain li + li::before {
    content: '→';
    color: var(--accent);
    padding: 0 0.5em;
  }
  .scope {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 52rem) {
    .scope {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  .scope h3 {
    margin-bottom: var(--space-2);
  }
  .scope__col p {
    margin: 0;
    font-size: var(--step--1);
  }
  .recent {
    --ledger-col: 6rem;
  }
  .recent__what {
    max-width: var(--measure);
  }
</style>
