---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Island from '../components/Island.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// The PhD project has its own block at the top, so the cards show the other featured projects.
const phd = all.find((p) => p.id === 'evolutionary-consequences-of-isolation');
if (!phd) throw new Error('The PhD project entry is missing from src/content/projects.');
const projects = all.filter((p) => p.data.featured && p.id !== phd.id);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: site.position,
  description: site.description,
  image: `${site.url}/images/portrait-640.jpg`,
  affiliation: {
    '@type': 'Organization',
    name: site.affiliation.name,
    url: 'https://www.rug.nl/',
    department: {
      '@type': 'Organization',
      name: site.affiliation.unit,
      alternateName: site.affiliation.unitShort,
      url: site.affiliation.url,
    },
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of Montpellier' },
    { '@type': 'CollegeOrUniversity', name: 'University of the Aegean' },
  ],
  knowsAbout: [
    'Complex systems',
    'Mathematical modelling',
    'Computational modelling',
    'Eco-evolutionary dynamics',
    'Theoretical ecology',
    'Evolutionary biology',
    'Stochastic simulation',
    'Sustainability science',
  ],
  identifier: { '@type': 'PropertyValue', propertyID: 'ORCID', value: site.orcidId },
  sameAs: [site.profiles.orcid, site.profiles.github, site.profiles.scholar, site.profiles.rug, site.profiles.researchgate],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  author: { '@id': `${site.url}/#person` },
};
---

<Base title="Home" description={site.description} home schema={[personSchema, websiteSchema]} ogType="profile">
  <section class="container intro" aria-label="Introduction">
    <h1>{site.name}</h1>
    <p class="intro__role">
      {site.position}, {site.affiliation.unit} ({site.affiliation.unitShort}), {site.affiliation.name}
    </p>
    <div class="intro__grid">
      <picture class="intro__portrait">
        <source
          type="image/avif"
          srcset="/images/portrait-480.avif 480w, /images/portrait-960.avif 960w"
          sizes="(min-width: 42rem) 16rem, 60vw"
        />
        <source
          type="image/webp"
          srcset="/images/portrait-480.webp 480w, /images/portrait-960.webp 960w"
          sizes="(min-width: 42rem) 16rem, 60vw"
        />
        <img
          src="/images/portrait-640.jpg"
          width="640"
          height="800"
          alt="Alexandros Kaminas, portrait in a dark suit against a white background."
          loading="eager"
          decoding="async"
        />
      </picture>
      <div class="intro__text">
        <p class="lede">
          I build mathematical and computational models of ecological communities and evolving populations.
        </p>
        <div class="intro__phd">
          <p class="label">PhD project</p>
          <p class="intro__phd-title">
            <a href={`/work/${phd.id}/`}>{phd.data.title}</a>
          </p>
          <p>{phd.data.question}</p>
          <p class="muted small">Since October 2025, with Rampal Etienne and Sander van Doorn.</p>
        </div>
      </div>
    </div>
  </section>

  <Section id="research" title="Research">
    <div class="stack">
      <p>
        I work mostly on ecology and evolution: stochastic and dynamical models of communities, and of how the traits
        of interacting species evolve. Earlier projects covered regime shifts in Mediterranean fish and invertebrate
        communities and the functional diversity of Mediterranean fish.
      </p>
      <p>
        Outside ecology I work on organisations and sustainability: a 2026 paper on organisational commitment among
        Greek NGOs, and climate-change reporting with the Political Economy of Sustainable Development Lab at the
        University of Athens.
      </p>
    </div>
  </Section>

  <Section id="work" wide>
    <div class="sec__head">
      <h2 id="work-title">Other projects</h2>
      <a class="arrow-link" href="/work/">All projects and talks</a>
    </div>
    <div class="cards">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </Section>

  <Section id="island" title="Explore the island" intro="The island below links to the main sections." wide>
    <Island />
  </Section>

  <Section id="methods" title="Methods">
    <div class="stack">
      <p>
        Models are built from explicit processes, studied by stochastic simulation and dynamical-systems analysis, and
        compared with data statistically. Simulation code is in C++; analysis and visualisation are in R and Python.
      </p>
      <ul class="chips" aria-label="Method areas">
        <li>Eco-evolutionary models</li>
        <li>Stochastic simulation</li>
        <li>Dynamical systems &amp; transitions</li>
        <li>Interaction networks</li>
        <li>Trait-space &amp; functional diversity</li>
        <li>Statistical modelling</li>
        <li>Spatial analysis</li>
        <li>Data visualisation</li>
      </ul>
      <a class="arrow-link" href="/methods/">Methods in detail</a>
    </div>
  </Section>

  <Section id="recent" title="Recent, 2025 – 2026">
    <ol class="ledger recent">
      <li>
        <span class="ledger__when">2026-06</span>
        <span class="recent__what">
          Talk at the NVTB Annual Schoorl Meeting:{' '}
          <a href="/work/evolutionary-consequences-of-isolation/"><em>Isolation as a dynamic driver of eco-evolutionary change</em></a>.
        </span>
      </li>
      <li>
        <span class="ledger__when">2026-04</span>
        <span class="recent__what">
          Paper published in <em>Circular Economy and Sustainability</em> on{' '}
          <a href="/publications/#alevizos-2026-ngo-sustainability">organisational commitment to sustainability among Greek NGOs</a>.
        </span>
      </li>
      <li>
        <span class="ledger__when">2026</span>
        <span class="recent__what">
          Supervised an MSc research project on{' '}
          <a href="/work/trait-evolution-in-mutualistic-networks/">trait evolution in mutualistic networks</a> at TRÊS.
        </span>
      </li>
      <li>
        <span class="ledger__when">2025-10</span>
        <span class="recent__what">
          Started the PhD <em>The evolutionary consequences of isolation</em> at the University of Groningen as an
          EVOLVE fellow (EU MSCA COFUND).
        </span>
      </li>
    </ol>
  </Section>

  <Section id="contact" title="Collaboration and supervision">
    <div class="stack">
      <p>
        I am glad to hear from researchers working on eco-evolutionary dynamics, complex systems and quantitative
        sustainability, and from students interested in modelling projects.
      </p>
      <p>
        <a class="button button--primary" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </Section>
</Base>

<style>
  .intro {
    padding-block: var(--space-7) var(--space-4);
  }
  .intro h1 {
    margin-bottom: var(--space-1);
  }
  .intro__role {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: var(--space-6);
  }
  .intro__grid {
    display: grid;
    gap: var(--space-5) var(--space-7);
    align-items: start;
  }
  @media (min-width: 42rem) {
    .intro__grid {
      grid-template-columns: 16rem minmax(0, 1fr);
    }
  }
  .intro__portrait {
    width: min(100%, 16rem);
  }
  .intro__portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .intro__text .lede {
    margin-bottom: var(--space-5);
  }
  .intro__phd p {
    margin-bottom: var(--space-1);
  }
  .intro__phd-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    line-height: 1.25;
  }
  .recent {
    --ledger-col: 6rem;
  }
  .recent__what {
    max-width: var(--measure);
  }
</style>
