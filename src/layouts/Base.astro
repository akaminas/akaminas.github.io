---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  /** Page title without the site name; the layout appends " · Alexandros Kaminas". */
  title: string;
  description: string;
  /** Absolute or root-relative path to a social image; defaults to the site image. */
  image?: string;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  /** Set to true on the home page so the H1 carries the site name. */
  home?: boolean;
  /** Open Graph type. */
  ogType?: 'website' | 'article' | 'profile';
}

const { title, description, image = '/og.png', schema = [], home = false, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const fullTitle = home ? `${site.name} · ${site.tagline}` : `${title} · ${site.name}`;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#e6ecf1" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e1a26" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <script is:inline>
      // Apply a stored theme choice before first paint. Reads one localStorage key
      // ("theme", written only by the header toggle; see src/scripts/theme.ts) and
      // ignores it after 180 days. Nothing is written here.
      (function () {
        try {
          var raw = localStorage.getItem('theme');
          if (!raw) return;
          var o = JSON.parse(raw);
          var fresh = o && typeof o.t === 'number' && Date.now() - o.t < 180 * 864e5;
          if (fresh && (o.v === 'light' || o.v === 'dark')) {
            document.documentElement.setAttribute('data-theme', o.v);
            var metas = document.getElementsByName('theme-color');
            for (var i = 0; i < metas.length; i++) {
              metas[i].setAttribute('content', o.v === 'dark' ? '#0e1a26' : '#e6ecf1');
              metas[i].removeAttribute('media');
            }
          } else {
            localStorage.removeItem('theme');
          }
        } catch (e) {}
      })();
    </script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href="/fonts/google-sans-flex-latin-wght-slnt.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {schema.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header currentPath={currentPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer currentPath={currentPath} />
  </body>
</html>
